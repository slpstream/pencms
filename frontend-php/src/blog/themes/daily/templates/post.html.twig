{{ theme.partial('head', { is_content: true }) | raw }}
{{ theme.partial('header') | raw }}

{% if hero_title is defined and hero_title %}
    {% set post_title = hero_title %}
{% elseif title is defined and title %}
    {% set post_title = title %}
{% else %}
    {% set post_title = 'Untitled' %}
{% endif %}
{% if deck is defined and deck %}
    {% set standfirst = deck | striptags %}
{% else %}
    {% set standfirst = '' %}
{% endif %}
{% if trumpet is defined and trumpet %}
    {% set post_kicker = trumpet %}
{% elseif section is defined and section %}
    {% set post_kicker = section %}
{% elseif category is defined and category %}
    {% set post_kicker = category %}
{% else %}
    {% set post_kicker = '' %}
{% endif %}
{% if hero_image is defined %}
    {% set post_hero = hero_image %}
{% else %}
    {% set post_hero = false %}
{% endif %}
{% if slug is defined %}
    {% set post_slug = slug %}
{% else %}
    {% set post_slug = '' %}
{% endif %}
{% if author is defined and author.display_name is defined and author.display_name %}
    {% set author_name = author.display_name %}
{% elseif author is defined and author.name is defined and author.name %}
    {% set author_name = author.name %}
{% elseif author is defined %}
    {% set author_name = author %}
{% else %}
    {% set author_name = '' %}
{% endif %}
{% if author is defined and author.avatar is defined %}
    {% set author_avatar = author.avatar %}
{% else %}
    {% set author_avatar = '' %}
{% endif %}

<div class="page">
    <article class="story">
        <header class="story-head">
        {% if post_kicker %}
            <p class="kicker">{{ post_kicker }}</p>
        {% endif %}
        <h1>{{ post_title }}</h1>
        {% if standfirst %}
            <p class="dek">{{ standfirst }}</p>
        {% endif %}
        <p class="meta">
            {% if date is defined and date %}
                <time datetime="{{ date | date('Y-m-d') }}">{{ date | date('M j, Y') }}</time>
            {% endif %}
        </p>
        </header>

        {% if post_hero and post_hero != 'images/defaulthero.jpg' %}
            <figure class="hero">
                <img src="{{ theme.contentAsset(post_hero) }}" alt="">
                {% if (caption is defined and caption) or (credit is defined and credit) %}
                    <figcaption>
                        {% if caption is defined %}<span>{{ caption }}</span>{% endif %}
                        {% if credit is defined and credit %}<span class="credit">{{ credit }}</span>{% endif %}
                    </figcaption>
                {% endif %}
            </figure>
        {% endif %}

        <div class="byline">
            <div class="byline-author">
                {% if author_avatar %}
                    <img src="{{ author_avatar }}" alt="">
                {% endif %}
                {% if author_name %}
                    <span>By {{ author_name }}</span>
                {% endif %}
            </div>
            {{ theme.partial('author-social') | raw }}
        </div>

        <div class="article-content traven-preview prose">
            {% if posts is defined and posts is not empty %}
                {% for post_item in posts %}
                    <section id="{{ post_item.id }}">
                        {% if post_item.title is not empty and posts|length > 1 %}
                            <h2>{{ post_item.title }}</h2>
                        {% endif %}
                        {{ post_item.content_html | raw }}
                    </section>
                {% endfor %}
            {% elseif page_content is defined and page_content is not empty %}
                {{ page_content | raw }}
            {% endif %}
        </div>

        {{ theme.partial('faqs') | raw }}

        <section class="daily-discussion">
            {{ theme.partial('comment-thread') | raw }}
            {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
        </section>
    </article>

    {{ theme.partial('story-rail', { skip_slug: post_slug }) | raw }}
</div>

{{ theme.partial('sidebar-related') | raw }}

{{ theme.partial('footer') | raw }}
