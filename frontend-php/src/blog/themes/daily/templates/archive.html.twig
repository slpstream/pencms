{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<div class="page page--list">
    <h1 class="list-heading">{{ hero_title | default('Archive') | title }}</h1>
    <div class="list-rows">
        {% for dossier in dossiers %}
            {% set url = contentUrl(dossier) %}
            {% set has_thumb = dossier.hero_image is defined and dossier.hero_image is not empty and dossier.hero_image != 'images/defaulthero.jpg' %}
            <article class="list-row">
                {% if has_thumb %}
                    <a class="list-row-thumb" href="{{ url }}"><img src="{{ theme.contentAsset(dossier.hero_image) }}" alt="" width="120" height="120"></a>
                {% endif %}
                <div class="list-row-body">
                    {% if dossier.trumpet is defined and dossier.trumpet %}
                        <p class="list-row-trumpet">{{ dossier.trumpet }}</p>
                    {% endif %}
                    <h2><a href="{{ url }}">{% if dossier.hero_title is defined and dossier.hero_title %}{{ dossier.hero_title }}{% elseif dossier.title is defined and dossier.title %}{{ dossier.title }}{% else %}Untitled{% endif %}</a></h2>
                    {% if dossier.deck is defined and dossier.deck %}
                        <p class="lead-excerpt">{{ dossier.deck | striptags }}</p>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <p class="empty">No stories in this section yet.</p>
        {% endfor %}
    </div>
</div>

{{ theme.partial('footer') | raw }}
