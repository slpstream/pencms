</main>
{% set home_url = base_path ~ (theme.isStatic() ? 'index.html' : 'index.php') %}
{% set footer_items = menu('footer') %}
<footer class="site-footer">
    <div class="footer-main">
        <div class="footer-brand">
            <a class="logo" href="{{ home_url }}">{{ sitename | default('Daily') }}</a>
            <p class="footer-colophon">
                {% if tagline | default('') is not empty %}
                    {{ tagline }}
                {% else %}
                    Printed matter for a screen.
                {% endif %}
            </p>
            {% if social_links is defined and social_links is not empty %}
            <div class="footer-follow">
                <h2 class="footer-heading">Follow</h2>
                {{ theme.partial('social-links') | raw }}
            </div>
            {% endif %}
        </div>

        {% if footer_items is not empty %}
        <nav class="footer-columns" aria-label="Footer">
            {% for item in footer_items %}
                <div class="footer-col">
                    {% if item.target_type == 'label' %}
                        <h2 class="footer-heading">{{ item.label }}</h2>
                    {% else %}
                        <h2 class="footer-heading">
                            <a href="{{ item.url }}" {% if item.open_in_new_tab | default(false) %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
                        </h2>
                    {% endif %}
                    {% if item.children is not empty %}
                        <ul class="footer-links">
                            {% for child in item.children %}
                                <li>
                                    {% if child.target_type == 'label' %}
                                        <span>{{ child.label }}</span>
                                    {% else %}
                                        <a href="{{ child.url }}" {% if child.open_in_new_tab | default(false) %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endfor %}
        </nav>
        {% endif %}
    </div>
    <div class="footer-legal">
        <div class="footer-legal-inner">
            <p>&copy; {{ "now" | date("Y") }} <a href="{{ home_url }}">{{ sitename | default('Daily') }}</a> - Powered by <a href="https://pencms.org">PenCMS</a> - Daily theme</p>
            {{ theme.partial('sidebar-secondary') | raw }}
        </div>
    </div>
</footer>

<script src="{{ theme.asset('js/theme.js') }}"></script>
<script src="{{ publicAsset('vendor/katex/katex.min.js') }}"></script>
<script src="{{ publicAsset('vendor/katex/contrib/auto-render.min.js') }}"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (window.renderMathInElement) {
            renderMathInElement(document.body, {
                delimiters: [
                    {left: '$$', right: '$$', display: true},
                    {left: '$', right: '$', display: false},
                    {left: '\\(', right: '\\)', display: false},
                    {left: '\\[', right: '\\]', display: true}
                ],
                throwOnError: false
            });
        }
    });
</script>
<script src="{{ publicAsset('vendor/mermaid/mermaid.min.js') }}"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll('pre code.language-mermaid').forEach(function(codeBlock) {
            const pre = codeBlock.parentNode;
            const div = document.createElement('div');
            div.className = 'mermaid';
            div.textContent = codeBlock.textContent;
            pre.replaceWith(div);
        });
        document.querySelectorAll('.mermaid').forEach(function(el) {
            if (!el.getAttribute('data-src')) {
                el.setAttribute('data-src', el.textContent);
            }
        });
        if (window.mermaid) {
            var dark = document.documentElement.classList.contains('cm-wysiwym-dark')
                || document.documentElement.getAttribute('data-theme') === 'dark';
            mermaid.initialize({
                startOnLoad: false,
                theme: dark ? 'dark' : 'default'
            });
            if (typeof mermaid.run === 'function') {
                mermaid.run({ querySelector: '.mermaid' }).catch(function () {});
            } else if (typeof mermaid.init === 'function') {
                mermaid.init(undefined, document.querySelectorAll('.mermaid'));
            }
        }
    });
</script>
</body>
</html>
