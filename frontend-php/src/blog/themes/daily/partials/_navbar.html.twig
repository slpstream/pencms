{% set primary_menu = menu('primary') %}
<nav class="site-nav" id="nav-menu" aria-label="Primary">
    {% if primary_menu is not empty %}
        {% for item in primary_menu %}
            <div class="nav-item{% if item.children is not empty %} has-children{% endif %}">
                <div class="nav-item-main">
                    {% if item.target_type == 'label' %}
                        <span class="nav-label{% if item.children is not empty %} nav-trigger{% endif %}"{% if item.children is not empty %} tabindex="0" role="button" aria-haspopup="true" aria-expanded="false"{% endif %}>{{ item.label }}</span>
                    {% else %}
                        <a href="{{ item.url }}" class="nav-link{% if item.is_active | default(false) %} is-active{% endif %}" {% if item.is_active | default(false) %}aria-current="page"{% endif %} {% if item.open_in_new_tab | default(false) %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
                    {% endif %}
                    {% if item.children is not empty %}
                        <button type="button" class="nav-caret" aria-label="Toggle submenu for {{ item.label }}" aria-haspopup="true" aria-expanded="false">
                            <span aria-hidden="true">▾</span>
                        </button>
                    {% endif %}
                </div>
                {% if item.children is not empty %}
                    <div class="nav-dropdown" role="menu">
                        {% for child in item.children %}
                            {% if child.target_type == 'label' %}
                                <span class="nav-label">{{ child.label }}</span>
                            {% else %}
                                <a href="{{ child.url }}" class="nav-link" role="menuitem" {% if child.open_in_new_tab | default(false) %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
</nav>
