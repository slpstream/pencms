{% set secondary_items = menu('secondary') %}
{% if secondary_items is not empty %}
<nav class="footer-rail" aria-label="Secondary">
    <ul class="footer-rail-list">
        {% for item in secondary_items %}
            <li class="{% if item.children is not empty %}has-children{% endif %}">
                {% if item.target_type == 'label' %}
                    <span>{{ item.label }}</span>
                {% else %}
                    <a href="{{ item.url }}" {% if item.open_in_new_tab | default(false) %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
                {% endif %}
                {% if item.children is not empty %}
                    <ul>
                        {% for child in item.children %}
                            <li>
                                {% if child.target_type == 'label' %}
                                    <span>{{ child.label }}</span>
                                {% else %}
                                    <a href="{{ child.url }}" {% if child.open_in_new_tab | default(false) %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
