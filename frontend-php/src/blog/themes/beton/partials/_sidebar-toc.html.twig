{% if posts is not empty and posts|length > 1 %}
<div class="spec-block">
    <p class="spec-kicker mono">Sommaire</p>
    <ul class="spec-toc">
        {% for post in posts %}
            {% if post.id != 'index' %}
                {% set label = post.title | default('') %}
                {% if label is empty %}
                    {% if post.id == 'intro' or post.id == 'main' %}
                        {% set label = 'Introduction' %}
                    {% else %}
                        {% set label = post.id | replace({'-': ' ', '_': ' '}) | title %}
                    {% endif %}
                {% endif %}
                <li><a href="#{{ post.id }}">{{ label }}</a></li>
            {% endif %}
        {% endfor %}
    </ul>
</div>
{% endif %}
