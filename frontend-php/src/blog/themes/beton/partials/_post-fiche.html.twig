{% set url = contentUrl(dossier) %}
{% set fiche_no = fiche_index | default(1) %}
{% set title = dossier.hero_title | default(dossier.title | default('Untitled')) %}
{% set words = title|split(' ') %}
{% set has_hero = dossier.hero_image is not empty and dossier.hero_image != 'images/defaulthero.jpg' %}
{% set stamp_date = dossier.dateline | default(dossier.date | default('')) %}

<article class="fiche">
    <div class="wrap fiche-grid">
        <header class="fiche-head">
            <p class="fiche-kicker mono">
                Fiche nº {{ '%02d'|format(fiche_no) }}
                {% if dossier.category is not empty %} — {{ dossier.category | upper }}{% elseif dossier.section is not empty %} — {{ dossier.section | upper }}{% endif %}
            </p>
            <h2 class="fiche-title cast-type">
                <a href="{{ url }}">
                    {% if words|length > 1 %}
                        <span class="crane-clip"><span class="crane">{{ words|first }}</span></span>
                        <span class="crane-clip"><span class="crane">{{ words|slice(1)|join(' ') }}</span></span>
                    {% else %}
                        <span class="crane-clip"><span class="crane">{{ title }}</span></span>
                    {% endif %}
                </a>
            </h2>
            {% if dossier.trumpet is not empty %}
                <p class="fiche-trumpet mono">{{ dossier.trumpet | striptags }}</p>
            {% endif %}
        </header>

        {% if dossier.deck is not empty %}
            <div class="fiche-deck">{{ dossier.deck | striptags }}</div>
        {% endif %}

        {% if has_hero %}
            <a href="{{ url }}" class="fiche-plate" tabindex="-1" aria-hidden="true">
                <img src="{{ contentAsset(dossier.hero_image) }}" alt="">
            </a>
        {% endif %}
    </div>
</article>

<div class="joint" role="separator" aria-hidden="true">
    <span class="mono">Reprise de bétonnage{% if stamp_date %} — {{ stamp_date }}{% endif %}</span>
</div>
