{% if related_dossiers is not empty %}
<div class="spec-block">
    <p class="spec-kicker mono">Autres fiches</p>
    <ul class="spec-related">
        {% for post in related_dossiers %}
            {% set url = contentUrl(post) %}
            <li><a href="{{ url }}">{{ post.hero_title }}</a></li>
        {% endfor %}
    </ul>
</div>
{% endif %}
