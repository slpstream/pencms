{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set title_words = (hero_title | default('Untitled'))|split(' ') %}
{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}

<main id="main" class="site-main page-post">
    <section class="post-hero">
        <div class="wrap hero-grid">
            <p class="fiche-kicker mono">
                {% if trumpet is not empty %}{{ trumpet }}{% else %}Fiche{% endif %}
                {% if category is not empty %} — {{ category | upper }}{% endif %}
            </p>
            <h1 class="hero-title post-detail-title cast-type">
                {% if title_words|length > 1 %}
                    <span class="crane-clip"><span class="crane c1">{{ title_words|first }}</span></span>
                    <span class="crane-clip"><span class="crane c2">{{ title_words|slice(1)|join(' ') }}</span></span>
                {% else %}
                    <span class="crane-clip"><span class="crane c1">{{ hero_title }}</span></span>
                {% endif %}
            </h1>
            {% if deck is not empty %}
                <div class="hero-sub post-detail-deck">{{ deck | raw }}</div>
            {% endif %}
        </div>
        <div class="mesure mono stamp" aria-hidden="true">
            <i class="tick tl"></i>
            <span class="mesure-label">Largeur hors-tout — <b data-vw>0 PX</b></span>
            <i class="tick tr"></i>
        </div>
    </section>

    <div class="joint" role="separator" aria-hidden="true">
        <span class="mono">Reprise de bétonnage{% if dateline %} — {{ dateline }}{% elseif date %} — {{ date | date("d.m.Y") }}{% endif %}</span>
    </div>

    <div class="wrap post-slab">
        <div class="post-prose">
            {% if has_hero %}
                <figure class="post-hero-plate">
                    <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
                </figure>
            {% endif %}

            {% for post in posts %}
                <article class="post-body" id="{{ post.id }}">
                    {% if post.title is not empty and posts|length > 1 %}
                        <h2 class="fragment-title">{{ post.title }}</h2>
                    {% endif %}
                    <div class="article-content traven-preview">
                        {{ post.content_html | raw }}
                    </div>
                </article>
            {% endfor %}

            {{ theme.partial('faqs') | raw }}

            <section class="beton-discussion">
                {{ theme.partial('comment-thread') | raw }}
                {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
            </section>
        </div>

        <aside class="spec-rail" aria-label="Fiche">
            <dl class="spec mono">
                {% set byline = author is iterable ? (author.name | default('')) : author %}
                {% if byline is not empty %}
                    <div><dt>Auteur</dt><dd>{{ byline }}</dd></div>
                {% endif %}
                {% if dateline is not empty %}
                    <div><dt>Dateline</dt><dd><time datetime="{{ date }}">{{ dateline }}</time></dd></div>
                {% elseif date is not empty %}
                    <div><dt>Date</dt><dd><time datetime="{{ date }}">{{ date | date("d.m.Y") }}</time></dd></div>
                {% endif %}
                {% if category is not empty %}
                    <div><dt>Catégorie</dt><dd>{{ category }}</dd></div>
                {% endif %}
                {% if section is not empty %}
                    <div><dt>Section</dt><dd>{{ section }}</dd></div>
                {% endif %}
            </dl>
            {{ theme.partial('sidebar-toc') | raw }}
            {{ theme.partial('sidebar-related') | raw }}
        </aside>
    </div>
</main>

{{ theme.partial('footer') | raw }}
