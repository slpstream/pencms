{
  "type": "native",
  "name": "Cause",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "A trust-first theme for nonprofits and charities. Mission hero image, optional partials for impact number and a donate button. Deep teal on white, generous space, zero decoration.",
  "editor_skin": "cause",
  "color_mode": "both",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": false,
    "sidebars": false,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "dark_scope": {
      "selector": "html.cm-wysiwym-dark, html[data-theme=\"dark\"]"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--color-bg",
            "default": "#ffffff",
            "dark_default": "#171c1b"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--color-text",
            "default": "#232629",
            "dark_default": "#e6e7e5"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--color-muted",
            "default": "#5a6065",
            "dark_default": "#a0a7a4"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--color-accent",
            "default": "#0e6e66",
            "dark_default": "#4fb3a7"
          },
          {
            "id": "number",
            "label": "Impact Number",
            "type": "color",
            "var": "--color-number",
            "default": "#a05f06",
            "dark_default": "#e0a44b"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--color-border",
            "default": "#e3e5e4",
            "dark_default": "#2c3432"
          },
          {
            "id": "panel",
            "label": "Panel Background",
            "type": "color",
            "var": "--color-panel",
            "default": "#eef4f2",
            "dark_default": "#1f2725"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--font-display",
            "default": "'Plus Jakarta Sans', sans-serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Plus Jakarta Sans', sans-serif", "label": "Plus Jakarta Sans" },
              { "value": "'Roboto', sans-serif", "label": "Roboto" },
              { "value": "'Inter', sans-serif", "label": "Inter" },
              { "value": "'Outfit', sans-serif", "label": "Outfit" },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              { "value": "'Playfair Display', serif", "label": "Playfair Display" },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--font-body",
            "default": "'Plus Jakarta Sans', sans-serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Plus Jakarta Sans', sans-serif", "label": "Plus Jakarta Sans" },
              { "value": "'Roboto', sans-serif", "label": "Roboto" },
              { "value": "'Inter', sans-serif", "label": "Inter" },
              { "value": "'Outfit', sans-serif", "label": "Outfit" },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              { "value": "'Playfair Display', serif", "label": "Playfair Display" },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--font-mono",
            "default": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Fira Code', monospace", "label": "Fira Code" },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#0e6e66",
    "og_vignette_color": "#5a6065",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#0e6e66",
    "og_font": "PlusJakartaSans-Bold",
    "og_fonts": {
      "PlusJakartaSans-Bold": "assets/fonts/PlusJakartaSans-Bold.ttf",
      "PlusJakartaSans-Regular": "assets/fonts/PlusJakartaSans-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": "assets/images/watermark.png",
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
