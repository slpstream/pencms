{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
    {% set is_hero_page = (page_has_hero is defined and page_has_hero) or (has_hero is defined and has_hero) or (hero is defined and hero) %}
    {% if is_hero_page %}
        <article class="page has-hero">
            <section class="hero">
                <figure class="hero-photo">
                    {% if hero_image is defined and hero_image is not empty %}
                        <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_alt | default(page_title | default('Hero image')) }}" decoding="async">
                    {% else %}
                        <img src="{{ theme.asset('images/defaulthero.jpg') }}" alt="Community program" decoding="async">
                    {% endif %}
                </figure>
                <div class="impact">
                    <strong class="impact-number">{{ impact_number | default('1,142') }}</strong>
                    <span class="impact-what">{{ impact_unit | default('adult readers') }} {{ impact_verb | default('learning right now') }}</span>
                </div>
                <div class="hero-mission">
                    <h1>{{ page_title | default(hero_title | default(title | default('Untitled Page'))) }}</h1>
                    {% set mission_text = deck | default(tagline | default('')) | striptags %}
                    {% if mission_text is not empty %}
                        <p class="mission">{{ mission_text }}</p>
                    {% endif %}
                    <p class="hero-actions">
                        <a class="btn-donate btn-large" href="{{ donate_url | default('/donate/') }}">Donate</a>
                        <span class="donate-prompt">{{ donate_prompt | default("£10 buys a learner's first three books.") }}</span>
                    </p>
                </div>
            </section>
            
            {% if page_content is defined and page_content is not empty %}
                <div class="article-content traven-preview prose">
                    {{ page_content | raw }}
                </div>
            {% elseif posts is defined and posts is not empty %}
                {% for item in posts %}
                    <div class="article-content traven-preview prose">
                        {{ item.content_html | raw }}
                    </div>
                {% endfor %}
            {% elseif post is defined and post.content_html is defined %}
                <div class="article-content traven-preview prose">
                    {{ post.content_html | raw }}
                </div>
            {% endif %}

            {{ theme.partial('faqs') | raw }}
        </article>
    {% else %}
        <article class="page">
            <header class="page-header">
                <h1>{{ page_title | default(hero_title | default(title | default('Untitled Page'))) }}</h1>
                {% set deck_text = deck | default('') | striptags %}
                {% if deck_text is not empty %}
                    <p class="lede">{{ deck_text }}</p>
                {% endif %}
            </header>
            {% if (donate_cta is defined and donate_cta) or (show_donate is defined and show_donate) %}
                <p class="page-actions">
                    <a class="btn-donate btn-large" href="{{ donate_url | default('/donate/') }}">Donate online</a>
                    <span class="donate-prompt">{{ donate_prompt | default("£10 buys a learner's first three books.") }}</span>
                </p>
            {% endif %}
            
            {% if page_content is defined and page_content is not empty %}
                <div class="article-content traven-preview prose">
                    {{ page_content | raw }}
                </div>
            {% elseif posts is defined and posts is not empty %}
                {% for item in posts %}
                    <div class="article-content traven-preview prose">
                        {{ item.content_html | raw }}
                    </div>
                {% endfor %}
            {% elseif post is defined and post.content_html is defined %}
                <div class="article-content traven-preview prose">
                    {{ post.content_html | raw }}
                </div>
            {% endif %}

            {{ theme.partial('faqs') | raw }}
        </article>
    {% endif %}
</main>

{{ theme.partial('footer') | raw }}
