{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
    <article class="post">
        <header class="page-header">
            {% if date is defined and date is not empty %}
                <time class="post-date" datetime="{{ date }}">{{ date | date('F d, Y') }}</time>
            {% endif %}
            <h1>{{ hero_title | default(title | default('Untitled')) }}</h1>
            {% set deck_text = deck | default('') | striptags %}
            {% if deck_text is not empty %}
                <p class="lede">{{ deck_text }}</p>
            {% endif %}
            {% if tags is defined and tags is not empty %}
                <p class="tags">
                    {% for t in tags %}
                        <a class="tag" href="{{ base_path ~ (theme.isStatic() ? 'tag/' ~ t ~ '/index.html' : 'archive.php?tag=' ~ t) }}">{{ t }}</a>
                    {% endfor %}
                </p>
            {% endif %}
        </header>

        {% if hero_image is defined and hero_image is not empty %}
            <img class="cover" src="{{ contentAsset(hero_image) }}" alt="" loading="lazy" decoding="async">
        {% endif %}

        {% if page_content is defined and page_content is not empty %}
            <div class="article-content traven-preview prose">
                {{ page_content | raw }}
            </div>
        {% elseif posts is defined and posts is not empty %}
            {% for item in posts %}
                <div class="article-content traven-preview prose">
                    {{ item.content_html | raw }}
                </div>
            {% endfor %}
        {% elseif post is defined and post.content_html is defined %}
            <div class="article-content traven-preview prose">
                {{ post.content_html | raw }}
            </div>
        {% endif %}

        {{ theme.partial('faqs') | raw }}

        <section class="cause-discussion">
            {{ theme.partial('comment-thread') | raw }}
            {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
        </section>
    </article>
</main>

{{ theme.partial('footer') | raw }}
