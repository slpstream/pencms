<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if hero_title is defined and hero_title is not empty and sitename is defined and sitename is not empty and hero_title != sitename %}{{ hero_title }} | {{ sitename }}{% else %}{{ page_title | default(hero_title | default(sitename | default('Cause'))) }}{% endif %}</title>

    {% set desc = meta_description | default(deck | default(tagline | default(''))) | striptags %}
    {% if desc is not empty %}
        <meta name="description" content="{{ desc }}">
    {% endif %}

    {# OpenGraph / Twitter Social Meta #}
    <meta property="og:site_name" content="{{ sitename | default('Cause') }}">
    <meta property="og:title" content="{{ page_title | default(hero_title | default(sitename | default('Cause'))) }}">
    {% if desc is not empty %}
        <meta property="og:description" content="{{ desc }}">
    {% endif %}
    {% if hero_image is defined and hero_image is not empty %}
        <meta property="og:image" content="{{ contentAsset(hero_image) }}">
        <meta name="twitter:card" content="summary_large_image">
    {% endif %}

    <meta name="color-scheme" content="light dark">

    {# Prevent theme flash on load #}
    <script>
        (function() {
            let scheme = null;
            try {
                scheme = localStorage.getItem('color-scheme') || localStorage.getItem('theme');
            } catch (e) {}
            if (!scheme) {
                try {
                    const match = document.cookie.match(/(^|;)\s*(?:color-scheme|theme)\s*=\s*([^;]+)/);
                    scheme = match ? match[2] : null;
                } catch (e) {}
            }
            if (scheme === 'dark' || (!scheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else if (scheme === 'light') {
                document.documentElement.classList.remove('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>


    {# Mandatory KaTeX & Expand/Embed Nutshell Assets (GOTCHAS §9 & KB A17) #}
    <link rel="stylesheet" href="{{ publicAsset('vendor/katex/katex.min.css') }}">
    <link rel="stylesheet" href="{{ publicAsset('vendor/traven/expand-embed.css') }}">
    <script type="module" src="{{ publicAsset('vendor/traven/expand-embed-runtime.js') }}"></script>

    {# Shared font registry (Style Settings select options) + theme CSS #}
    <link rel="stylesheet" href="{{ publicAsset('fonts/fonts.css') }}">
    {{ theme.linkCss('css/styles.css') | raw }}
    {{ theme.linkCss('css/skin-cause.css') | raw }}
</head>
<body class="traven-preview">
