{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<div class="musings-header-meta">
    PAGE / {{ page_title | default(title | default('PAGE')) | upper }}
</div>

<article class="musings-page-detail">
    <header class="musings-post-header">
        <h1>{{ page_title | default(title | default('Untitled')) }}</h1>
    </header>

    {% if hero_image is defined and hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
        <div class="musings-post-hero-image">
            <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title | default(page_title | default('')) }}">
        </div>
    {% endif %}

    {% set main_content = page_content | default(content_html | default(content | default(body | default('')))) %}
    <div class="article-content traven-preview" style="margin-bottom: 3rem;">
        {% if main_content is not empty %}
            {{ main_content | raw }}
        {% elseif posts is defined and posts is not empty %}
            {% for p in posts %}
                {{ p.content_html | default(p.content | default('')) | raw }}
            {% endfor %}
        {% endif %}
    </div>

    {{ theme.partial('faqs') | raw }}
</article>

{{ theme.partial('footer') | raw }}
