<nav class="musings-primary-nav" aria-label="Primary Navigation">
    {% set nav_items = menu('primary') %}
    <ul>
        {% for index, item in nav_items %}
            {% set num_str = (index < 10 ? '0' ~ index : '' ~ index) %}
            <li class="{% if item.children is not empty %}has-children{% endif %}">
                {% if item.target_type == 'label' %}
                    <span class="nav-label">
                        <span class="nav-prefix">{{ num_str }}</span> {{ item.label }}
                    </span>
                {% else %}
                    <a href="{{ item.url }}" {% if item.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>
                        <span class="nav-prefix">{{ num_str }}</span> {{ item.label }}
                    </a>
                {% endif %}
                
                {% if item.children is not empty %}
                    <ul class="sub-menu">
                        {% for child in item.children %}
                            <li>
                                {% if child.target_type == 'label' %}
                                    <span class="nav-label">{{ child.label }}</span>
                                {% else %}
                                    <a href="{{ child.url }}" {% if child.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>
