{% if posts is not empty and posts|length > 1 %}
<nav class="night-crt-chit" aria-label="On this page">
    <p class="night-crt-fixed">POS v9.4 · FRAGMENTS</p>
    <ul class="night-crt-lines">
        {% for post in posts %}
            {% if post.id != 'index' %}
                {% set label = post.title | default('') %}
                {% if label is empty %}
                    {% if post.id == 'intro' or post.id == 'main' %}
                        {% set label = 'Introduction' %}
                    {% else %}
                        {% set label = post.id | replace({'-': ' ', '_': ' '}) | title %}
                    {% endif %}
                {% endif %}
                <li class="night-crt-line">
                    <a href="#{{ post.id }}">{{ '%02d'|format(loop.index) }} · {{ label }}</a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
    <p class="night-crt-prompt"><span class="night-crt-cursor" aria-hidden="true"></span></p>
</nav>
{% endif %}
