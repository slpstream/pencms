{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}

<main id="main" class="night-chamber-page page-page">
    <div class="night-beam" aria-hidden="true"></div>

    <header class="night-post-head">
        <div class="night-kicker-row">
            <p class="night-cjk-lantern night-cjk-lantern--inline tc" lang="zh-Hant" aria-hidden="true">晚</p>
        </div>
        <h1 class="post-detail-title page-heading night-tube-title">{{ hero_title | default(page_title | default('Untitled')) }}</h1>
        {% if deck is not empty %}
            <div class="post-detail-deck night-deck">{{ deck | raw }}</div>
        {% endif %}
        {% if has_hero %}
            <figure class="night-shopwindow">
                <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
            </figure>
        {% endif %}
    </header>

    <div class="night-chamber">
        {{ theme.partial('sidebar-secondary') | raw }}
        <div class="night-prose">
            <div class="article-content traven-preview">
                {{ page_content | raw }}
            </div>

            {{ theme.partial('faqs') | raw }}
        </div>
    </div>
</main>

{{ theme.partial('footer') | raw }}
