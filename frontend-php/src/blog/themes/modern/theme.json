{
  "type": "native",
  "name": "Modern",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Teal & Slate theme with a contemporary minimal design.",
  "editor_skin": "modern",
  "color_mode": "light",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--traven-bg",
            "default": "#ffffff"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--traven-text",
            "default": "#18181b"
          },
          {
            "id": "headings",
            "label": "Headings",
            "type": "color",
            "var": "--traven-h-color",
            "default": "#09090b"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--traven-caret",
            "default": "#115e59"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--traven-muted",
            "default": "#71717a"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--traven-border",
            "default": "#d4d4d8"
          },
          {
            "id": "code-bg",
            "label": "Code Background",
            "type": "color",
            "var": "--traven-code-bg",
            "default": "#f4f4f5"
          },
          {
            "id": "code-border",
            "label": "Code Border",
            "type": "color",
            "var": "--traven-code-border",
            "default": "#e4e4e7"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--traven-font-display",
            "default": "\"Saira Condensed\", sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "\"Saira Condensed\", sans-serif",
                "label": "Saira Condensed"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--traven-font-body",
            "default": "\"Epunda Slab\", Georgia, serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "\"Epunda Slab\", Georgia, serif",
                "label": "Epunda Slab"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--traven-font-mono",
            "default": "\"JetBrains Mono\", monospace",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "\"JetBrains Mono\", monospace",
                "label": "JetBrains Mono"
              },
              {
                "value": "'Fira Code', monospace",
                "label": "Fira Code"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#115e59",
    "og_vignette_color": "#64748B",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#0b0f19",
    "og_font": "SairaCondensed-Bold",
    "og_fonts": {
      "SairaCondensed-Bold": "assets/fonts/SairaCondensed-Bold.ttf",
      "SairaCondensed-Regular": "assets/fonts/SairaCondensed-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": "assets/images/watermark.png",
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
