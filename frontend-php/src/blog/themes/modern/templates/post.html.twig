{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-container">
    <div class="layout-grid layout-grid-post">
        <div>
            <header class="post-detail-header">
                <div class="post-detail-eyebrow">
                    <span class="post-card-category">{{ category | default(section | default(strings.post)) | upper }}</span>
                    {% if trumpet is not empty %}
                        <span class="post-detail-trumpet">{{ trumpet }}</span>
                    {% endif %}
                </div>
                <h1 class="post-detail-title">{{ hero_title }}</h1>
                {% if deck is not empty %}
                    <div class="post-detail-deck">{{ deck | raw }}</div>
                {% endif %}
                <div class="post-detail-meta">
                    {% if author is not empty %}
                        <span class="post-detail-byline">{{ strings.by }} {{ author }}</span>
                    {% endif %}
                    {% if dateline is not empty %}
                        {% if author is not empty %}<span class="meta-separator">&bull;</span>{% endif %}
                        <time datetime="{{ date }}">{{ dateline }}</time>
                    {% elseif date is not empty %}
                        {% if author is not empty %}<span class="meta-separator">&bull;</span>{% endif %}
                        <time datetime="{{ date }}">{{ date | date("F d, Y") }}</time>
                    {% endif %}
                </div>
            </header>

            {% if hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
                <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}" class="post-detail-hero-image">
            {% endif %}

            <div class="post-content-wrapper">
                {% for post in posts %}
                    <article class="post-body" id="{{ post.id }}">
                        {% if post.title is not empty and posts|length > 1 %}
                            <h2 class="fragment-title">{{ post.title }}</h2>
                        {% endif %}
                        <div class="article-content traven-preview">
                            {{ post.content_html | raw }}
                        </div>
                    </article>
                {% endfor %}

                {{ theme.partial('faqs') | raw }}
            </div>

            <section class="modern-discussion">
                {{ theme.partial('comment-thread') | raw }}
                {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
            </section>
        </div>

        <div class="sidebar-column">
            {{ theme.partial('sidebar-secondary') | raw }}
            {{ theme.partial('sidebar-profile') | raw }}
            
            {% if is_composite %}
                {{ theme.partial('sidebar-toc') | raw }}
            {% endif %}
            
            {{ theme.partial('sidebar-related') | raw }}
        </div>
    </div>
</main>

{{ theme.partial('footer') | raw }}
