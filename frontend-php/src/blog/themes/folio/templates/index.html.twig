{{ theme.partial('head') | raw }}
{{ theme.partial('header', { is_index: true }) | raw }}

{% set lead = dossiers|first %}
{% set rest = dossiers|slice(1) %}

{% set category_map = {} %}
{% for d in dossiers %}
    {% set cat = d.category|default(d.section|default('')) %}
    {% if cat is not empty and attribute(category_map, cat) is not defined %}
        {% set label = (d.term_labels[cat]|default(cat))|replace({'-': ' ', '_': ' '})|title %}
        {% set category_map = category_map|merge({ (cat): label }) %}
    {% endif %}
{% endfor %}

{% set edition_title = '' %}
{% if hero_title is not empty and hero_title != sitename|default('') and hero_title != tagline|default('') %}
    {% set edition_title = hero_title %}
{% endif %}

{{ theme.partial('slash', { edge: 'top' }) | raw }}

{# ═══ About — rotating star-ring around circular logo + Index Hero Title ═══ #}
{% set logo_url = theme.getLogoUrl() %}
<section class="folio-about{% if logo_url is empty %} folio-about--no-logo{% endif %}" id="about">
    {% if logo_url is not empty %}
    <div class="folio-about-logo" aria-hidden="true">
        <div class="folio-about-logo-frame">
            <img alt="" loading="lazy" src="{{ logo_url }}">
        </div>
        <svg class="folio-about-logo-ring folio-spin-slow" viewBox="0 0 320 320">
            <defs>
                <path d="M 160, 160 m -147, 0 a 147,147 0 1,1 294,0 a 147,147 0 1,1 -294,0" id="folio-circle-path"></path>
                <mask id="folio-border-mask">
                    <rect fill="black" height="320" width="320"></rect>
                    <circle cx="160" cy="160" fill="white" r="160"></circle>
                    <circle cx="160" cy="160" fill="black" r="142"></circle>
                </mask>
            </defs>
            <g mask="url(#folio-border-mask)">
                <text>
                    <textPath href="#folio-circle-path" startOffset="0%">
                        {% if tagline is defined and tagline is not empty %}
                            {% set tag_sep = tagline|trim ~ ' • ' %}
                            {{ tag_sep ~ tag_sep ~ tag_sep ~ tag_sep }}
                        {% else %}
                            {% for i in 1..22 %}&#11088; - {% endfor %}
                        {% endif %}
                    </textPath>
                </text>
            </g>
        </svg>
    </div>
    {% endif %}
    <div class="folio-about-inner">
        {% if sitename is not empty %}
            <div class="folio-about-sitename">{{ sitename }}</div>
        {% endif %}
        <h1>{{ edition_title | default('') }}</h1>
    </div>
</section>

{{ theme.partial('slash') | raw }}

{# ═══ Recent posts — lead feature + image card grid ═══ #}
<section class="folio-grid-section" id="projects">
    <div class="folio-grid-section-inner">
        {% if lead is not empty %}
            {% set lead_url = theme.isStatic() ? (base_path ~ lead.slug ~ '/index.html') : ('post.php?slug=' ~ lead.slug ~ '&section=' ~ (lead.section | default('blog'))) %}
            {% set lead_has_hero = lead.hero_image is not empty and lead.hero_image != 'images/defaulthero.png' %}
            {% set lead_cat = lead.category|default(lead.section|default('')) %}
            <article class="folio-grid-lead{% if not lead_has_hero %} folio-grid-lead--no-image{% endif %}" id="lead">
                <div class="folio-grid-lead-text">
                    <div class="post-detail-eyebrow">
                        <span class="post-card-category">{{ lead_cat|default('Post')|upper }}</span>
                        {% if lead.trumpet is not empty %}
                            <span class="post-detail-trumpet">{{ lead.trumpet | striptags }}</span>
                        {% endif %}
                    </div>
                    <h2 class="folio-grid-lead-title">
                        <a href="{{ lead_url }}" class="folio-grid-lead-title-link">{{ lead.hero_title | default(lead.title) }}</a>
                    </h2>
                    {% if lead.deck is not empty %}
                        <div class="post-detail-deck">{{ lead.deck | striptags }}</div>
                    {% endif %}
                    {% if lead.dateline is defined and lead.dateline is not empty %}
                        <div class="folio-grid-lead-meta">
                            <time datetime="{{ lead.date }}">{{ lead.dateline }}</time>
                        </div>
                    {% elseif lead.date is not empty %}
                        <div class="folio-grid-lead-meta">
                            <time datetime="{{ lead.date }}">{{ lead.date | date('F j, Y') }}</time>
                        </div>
                    {% endif %}
                </div>
                {% if lead_has_hero %}
                    <a href="{{ lead_url }}" class="folio-grid-lead-media">
                        <img alt="" loading="lazy" src="{{ contentAsset(lead.hero_image) }}">
                    </a>
                {% endif %}
            </article>
        {% else %}
            <p class="folio-grid-empty">No posts yet. Publish something worth reading.</p>
        {% endif %}

        <h2>Recent posts</h2>

        {% if rest is empty %}
            <p style="text-align:center;color:var(--folio-muted);padding:32px 0;">No more posts yet.</p>
        {% else %}
        <div class="folio-grid">
            {% for dossier in rest %}
                {% set url = theme.isStatic() ? (base_path ~ dossier.slug ~ '/index.html') : ('post.php?slug=' ~ dossier.slug ~ '&section=' ~ (dossier.section | default('blog'))) %}
                {% set has_hero = dossier.hero_image is not empty and dossier.hero_image != 'images/defaulthero.png' %}
                {# Alternate by ROW: row0 Large|Small, row1 Small|Large, ... (matches folio.html) #}
                {% set span_class = ((loop.index0 // 2 + loop.index0 % 2) is even) ? 'span-3' : 'span-2' %}
                {% set card_cat = dossier.category|default(dossier.section|default('')) %}
                {% set card_cat_label = (dossier.term_labels[card_cat]|default(card_cat))|replace({'-': ' ', '_': ' '})|title %}
                <a href="{{ url }}" class="folio-card {{ span_class }}">
                    <div class="folio-card-media">
                        {% if has_hero %}
                            <img alt="" loading="lazy" src="{{ contentAsset(dossier.hero_image) }}">
                        {% endif %}
                    </div>
                    {% if dossier.pinned|default(false) %}
                        <span class="folio-card-star" aria-label="Pinned">
                            <svg viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z" fill="currentColor"></path></svg>
                        </span>
                    {% endif %}
                    <span class="folio-card-category"><span>{{ card_cat_label|default('Post') }}</span></span>
                    <span class="folio-card-label">
                        <h2>{{ dossier.hero_title | default(dossier.title) }}</h2>
                        {% if dossier.date is not empty %}<time datetime="{{ dossier.date }}">{{ dossier.date | date('F j, Y') }}</time>{% endif %}
                    </span>
                </a>
            {% endfor %}
        </div>
        {% endif %}

        {% if category_map|length > 1 %}
        <nav style="margin-top:32px;text-align:right;" aria-label="Categories">
            <h3 style="font-family:var(--folio-font-display);font-size:1.15rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--folio-muted);margin-bottom:8px;">Topics</h3>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;">
                {% for slug, label in category_map %}
                    {% set cat_url = theme.isStatic() ? (base_path ~ 'category/' ~ slug ~ '/index.html') : ('category.php?category=' ~ slug|url_encode) %}
                    <li><a href="{{ cat_url }}" style="font-family:var(--folio-font-body);font-size:0.9rem;color:var(--folio-accent);text-decoration:none;">{{ label }}</a></li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
    </div>
</section>

{{ theme.partial('slash', { edge: 'bottom' }) | raw }}

{{ theme.partial('footer') | raw }}
