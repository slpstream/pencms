{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{{ theme.partial('slash', { edge: 'top' }) | raw }}

<main class="main-container page-container">
    {{ theme.partial('branding', { branding_variant: 'card' }) | raw }}

    <article class="post-detail-header">
        <h1 class="post-detail-title post-detail-hero-title">{{ hero_title }}</h1>

        {% if hero_image is not empty and hero_image != 'images/defaulthero.png' %}
            <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}" class="post-detail-hero-image" style="margin-bottom:32px;">
        {% endif %}

        <div class="article-content traven-preview">
            {{ page_content | raw }}
        </div>

        {{ theme.partial('faqs') | raw }}
    </article>
</main>

{{ theme.partial('slash', { edge: 'bottom' }) | raw }}

{{ theme.partial('footer') | raw }}
