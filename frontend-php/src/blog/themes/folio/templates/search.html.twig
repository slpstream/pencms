{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{{ theme.partial('slash', { edge: 'top' }) | raw }}

<section class="hero-banner">
    {{ theme.partial('branding', { branding_variant: 'card' }) | raw }}
    <h1 class="hero-title-text">{{ hero_title | default('Search') }}</h1>
    <p class="hero-tagline-text">Find posts and pages on this site.</p>
</section>

{{ theme.partial('slash') | raw }}

<main class="folio-grid-section">
    <div class="folio-grid-section-inner">
        <div
            id="pencms-search"
            class="pencms-search"
            data-search-index-url="{{ search_index_url | default('') }}"
            data-static="{{ theme.isStatic() ? '1' : '0' }}"
            data-base-path="{{ base_path }}"
            data-web-root="{{ base_path }}"
        >
            <label class="search-label" for="search-input">Search</label>
            <input
                type="search"
                id="search-input"
                class="search-input"
                name="q"
                placeholder="Search posts and pages…"
                autocomplete="off"
                enterkeyhint="search"
            >

            {% if search_index_json is defined and search_index_json is not null %}
            <script type="application/json" id="search-index-data">{{ search_index_json | raw }}</script>
            {% endif %}

            <div id="search-results" class="search-results" aria-live="polite"></div>
        </div>
    </div>
</main>

<script src="{{ publicAsset('vendor/minisearch/minisearch.min.js') }}"></script>
<script src="{{ publicAsset('vendor/minisearch/search-ui.js') }}"></script>

{{ theme.partial('slash', { edge: 'bottom' }) | raw }}

{{ theme.partial('footer') | raw }}
