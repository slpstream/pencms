{% set secondary_items = menu('secondary') %}
{% if secondary_items is not empty and (secondary_items.items is not defined or secondary_items.items is not empty) %}
{% set items = secondary_items.items is defined ? secondary_items.items : secondary_items %}
<nav class="footer-secondary-nav" aria-label="Secondary Navigation">
    <ul class="footer-secondary-list">
        {% for item in items %}
            <li class="footer-secondary-item{% if item.children is defined and item.children is not empty %} has-children{% endif %}">
                {% if item.target_type is defined and item.target_type == 'label' %}
                    <span class="footer-secondary-label">{{ item.label | default(item.title | default('')) }}</span>
                {% else %}
                    <a href="{{ item.url }}"
                       class="footer-secondary-link"
                       {% if item.open_in_new_tab is defined and item.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ item.label | default(item.title | default('')) }}</a>
                {% endif %}
                {% if item.children is defined and item.children is not empty %}
                    <ul class="footer-secondary-children">
                        {% for child in item.children %}
                            <li>
                                {% if child.target_type is defined and child.target_type == 'label' %}
                                    <span class="footer-secondary-label footer-secondary-label--child">{{ child.label | default(child.title | default('')) }}</span>
                                {% else %}
                                    <a href="{{ child.url }}"
                                       class="footer-secondary-link"
                                       {% if child.open_in_new_tab is defined and child.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ child.label | default(child.title | default('')) }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
