{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main-content">
    <header class="page-header">
        <h1>{{ (hero_title | default(archive_title | default('Archive'))) | title }}</h1>
        {% if deck is defined and deck is not empty %}
            <p class="lede">{{ deck | raw }}</p>
        {% endif %}
    </header>

    {% set items = dossiers | default(posts) %}
    {% if items is not empty %}
        <ul class="post-list">
            {% for item in items %}
                {% set url = item.url is defined and item.url is not empty ? item.url : (theme.isStatic() ? (base_path ~ item.slug ~ '/index.html') : ('post.php?slug=' ~ item.slug ~ '&section=' ~ (item.section | default('blog')))) %}
                <li class="post-row">
                    <time class="post-row-date" datetime="{{ item.date | date('Y-m-d') }}">{{ item.date | date('Y-m-d') }}</time>
                    <div class="post-row-content">
                        <h2>
                            <a href="{{ url }}">{{ item.hero_title | default(item.title | default('Untitled')) }}</a>
                        </h2>
                        {% if item.deck is defined and item.deck is not empty %}
                            <p class="post-row-desc">{{ item.deck | striptags }}</p>
                        {% elseif item.meta_description is defined and item.meta_description is not empty %}
                            <p class="post-row-desc">{{ item.meta_description | striptags }}</p>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="empty">No entries found in this archive.</p>
    {% endif %}

    {% if pagination is defined and pagination is not empty %}
        <nav class="pagination" aria-label="Pagination">
            {% if pagination.prev_url is defined and pagination.prev_url is not empty %}
                <a href="{{ pagination.prev_url }}" rel="prev">&larr; Newer</a>
            {% endif %}
            {% if pagination.next_url is defined and pagination.next_url is not empty %}
                <a href="{{ pagination.next_url }}" rel="next">Older &rarr;</a>
            {% endif %}
        </nav>
    {% endif %}
</main>

{{ theme.partial('footer') | raw }}
