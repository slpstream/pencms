{
  "type": "native",
  "name": "Casper Lite",
  "version": "1.0.0",
  "author": "PenCMS Team",
  "license": "MIT",
  "description": "A clean, modern, card-based theme inspired by Ghost's Casper.",
  "editor_skin": "casper-lite",
  "color_mode": "light",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": false,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--traven-bg",
            "default": "#ffffff"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--traven-text",
            "default": "#15171A"
          },
          {
            "id": "headings",
            "label": "Headings",
            "type": "color",
            "var": "--traven-h-color",
            "default": "#15171A"
          },
          {
            "id": "accent",
            "label": "Accent / Caret",
            "type": "color",
            "var": "--traven-caret",
            "default": "#15171A"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--traven-muted",
            "default": "#738a94"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--traven-border",
            "default": "#e5e7eb"
          },
          {
            "id": "border-light",
            "label": "Light Borders",
            "type": "color",
            "var": "--traven-border-light",
            "default": "#f0f2f5"
          },
          {
            "id": "code-bg",
            "label": "Code Background",
            "type": "color",
            "var": "--traven-code-bg",
            "default": "#f4f5f7"
          },
          {
            "id": "code-border",
            "label": "Code Border",
            "type": "color",
            "var": "--traven-code-border",
            "default": "#e5e7eb"
          },
          {
            "id": "blockquote-border",
            "label": "Blockquote Border",
            "type": "color",
            "var": "--traven-blockquote-border",
            "default": "#3EB0EF"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--traven-font-display",
            "default": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--traven-font-body",
            "default": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--traven-font-mono",
            "default": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Fira Code', monospace",
                "label": "Fira Code"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#15171A",
    "og_vignette_color": "#3EB0EF",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#15171A",
    "og_font": "Inter-Bold",
    "og_fonts": {
      "Inter-Bold": "assets/fonts/Inter-Bold.ttf",
      "Inter-Regular": "assets/fonts/Inter-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": false,
    "og_watermark": "assets/images/watermark.png",
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
