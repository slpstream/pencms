    {{ theme.partial('head') | raw }}
    {{ theme.partial('header') | raw }}

    <article class="site-main">
        <header class="article-header container-narrow">
            <h1 class="article-title">{{ hero_title }}</h1>
            {% if deck is not empty %}
                <div class="article-deck">
                    {{ deck | raw }}
                </div>
            {% endif %}
        </header>

        {% if hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
            <figure class="article-hero-wrap">
                <img src="{{ contentAsset(hero_image) }}" class="article-hero-img" alt="">
            </figure>
        {% endif %}

        <section class="container-wide page-section">
            <div class="article-content traven-preview">
                {{ page_content | raw }}
            </div>

            {{ theme.partial('faqs') | raw }}
        </section>
    </article>

    {{ theme.partial('footer') | raw }}
