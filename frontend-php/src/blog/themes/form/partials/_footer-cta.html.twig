{% if schedule is defined and schedule is not null and schedule.trialNote is defined %}
  <p class="colophon-trial">{{ schedule.trialNote }} <a href="{{ base_path | default('/') ~ 'schedule/' }}">See the schedule</a>.</p>
{% else %}
  <p class="colophon-trial">First class free — just come 10 minutes early and say hi at the desk. <a href="{{ base_path | default('/') ~ 'schedule/' }}">See the schedule</a>.</p>
{% endif %}
