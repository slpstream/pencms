{% if schedule_data is not null and schedule_data.days is defined %}
<section class="timetable" aria-label="Weekly class schedule">
  {% if schedule_data.trialNote is defined and schedule_data.trialNote %}
    <p class="trial-note">{{ schedule_data.trialNote }}</p>
  {% endif %}
  <div class="week">
    {% for day in schedule_data.days %}
      <section class="day" data-day="{{ day.day }}">
        <h2 class="day-name">{{ day.day }}</h2>
        <ul class="classes">
          {% for session in day.classes %}
            <li class="session">
              <span class="session-time">{{ session.time }}</span>
              <span class="session-what">
                <span class="session-name">{{ session.name }}</span>
                {% if session.who is defined and session.who %}
                  <span class="session-who">with {{ session.who }}</span>
                {% endif %}
              </span>
              {% if session.level is defined and session.level %}
                <span class="chip">{{ session.level }}</span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
</section>
{% endif %}
