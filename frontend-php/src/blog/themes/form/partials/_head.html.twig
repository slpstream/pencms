<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page_title is defined and page_title %}{{ page_title }} · {% endif %}{{ sitename }}</title>
{% if meta_description is defined and meta_description %}<meta name="description" content="{{ meta_description }}">{% endif %}
<meta property="og:title" content="{% if page_title is defined and page_title %}{{ page_title }}{% else %}{{ sitename }}{% endif %}">
{% if meta_description is defined and meta_description %}<meta property="og:description" content="{{ meta_description }}">{% endif %}
<meta property="og:type" content="{% if dossier is defined and dossier is not null and dossier.date is defined and dossier.date %}article{% else %}website{% endif %}">
{% if hero_image is defined and hero_image %}<meta property="og:image" content="{{ contentAsset(hero_image) }}">
<meta name="twitter:card" content="summary_large_image">
{% endif %}
<meta name="color-scheme" content="light dark">

{# Prevent theme flash on load #}
<script>
    (function() {
        let scheme = null;
        try {
            scheme = localStorage.getItem('color-scheme') || localStorage.getItem('theme');
        } catch (e) {}
        if (!scheme) {
            try {
                const match = document.cookie.match(/(^|;)\s*(?:color-scheme|theme)\s*=\s*([^;]+)/);
                scheme = match ? match[2] : null;
            } catch (e) {}
        }
        if (scheme === 'dark' || (!scheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('cm-wysiwym-dark');
            document.documentElement.setAttribute('data-theme', 'dark');
        } else if (scheme === 'light') {
            document.documentElement.classList.remove('cm-wysiwym-dark');
            document.documentElement.setAttribute('data-theme', 'light');
        }
    })();
</script>

{# KaTeX Math Stylesheet #}
<link rel="stylesheet" href="{{ publicAsset('vendor/katex/katex.min.css') }}">

{# Expand / Embed Nutshell Runtime #}
<link rel="stylesheet" href="{{ publicAsset('vendor/traven/expand-embed.css') }}">
<script type="module" src="{{ publicAsset('vendor/traven/expand-embed-runtime.js') }}"></script>

{# Shared font registry (Style Settings + identity faces) #}
<link rel="stylesheet" href="{{ publicAsset('fonts/fonts.css') }}">

{# Theme Stylesheets #}
<link rel="stylesheet" href="{{ theme.asset('css/styles.css') }}">
<link rel="stylesheet" href="{{ theme.asset('css/skin-form.css') }}">
</head>
<body class="traven-preview">
<a class="skip-link" href="#main">Skip to content</a>
