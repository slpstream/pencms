<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title | default(hero_title | default(sitename)) }} · {{ sitename }}</title>
    {% if meta_description is defined and meta_description is not empty %}
    <meta name="description" content="{{ meta_description }}">
    {% elseif tagline is defined and tagline is not empty %}
    <meta name="description" content="{{ tagline }}">
    {% endif %}
    <meta name="color-scheme" content="light dark">

    {# Prevent theme flash on load #}
    <script>
        (function() {
            let scheme = null;
            try {
                scheme = localStorage.getItem('color-scheme') || localStorage.getItem('theme');
            } catch (e) {}
            if (!scheme) {
                try {
                    const match = document.cookie.match(/(^|;)\s*(?:color-scheme|theme)\s*=\s*([^;]+)/);
                    scheme = match ? match[2] : null;
                } catch (e) {}
            }
            if (scheme === 'dark' || (!scheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else if (scheme === 'light') {
                document.documentElement.classList.remove('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>


    {# KaTeX Math Stylesheet #}
    <link rel="stylesheet" href="{{ publicAsset('vendor/katex/katex.min.css') }}">

    {# Expand / Embed Nutshell Runtime #}
    <link rel="stylesheet" href="{{ publicAsset('vendor/traven/expand-embed.css') }}">
    <script type="module" src="{{ publicAsset('vendor/traven/expand-embed-runtime.js') }}"></script>

    {# Shared web fonts #}
    <link rel="stylesheet" href="{{ publicAsset('fonts/fonts.css') }}">

    {# Theme Stylesheets #}
    {{ theme.linkCss('css/skin-cv.css') | raw }}
    {{ theme.linkCss('css/styles.css') | raw }}
</head>
<body class="traven-preview">
<a class="skip-link" href="#main">Skip to content</a>
