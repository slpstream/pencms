{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<div class="layout has-rail">
  {{ theme.partial('sidebar-profile') | raw }}

  <main id="main">
    <article class="page">
      <header class="page-header">
        <h1>{{ hero_title | default(page_title | default('Page')) }}</h1>
