{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<div class="layout has-rail">
  {{ theme.partial('sidebar-profile') | raw }}

  <main id="main">
    <article class="role post">
      <header class="page-header">
        <p class="eyebrow">
          <span class="cv-category">{{ category | default(section | default('Experience')) }}</span>
          {% if trumpet is defined and trumpet is not empty %}
            <span class="cv-eyebrow-sep">·</span>
            <span class="post-detail-trumpet">{{ trumpet }}</span>
          {% endif %}
        </p>
        <h1>
          {{ hero_title | default(title | default('Untitled')) }}
          {% if organization is defined and organization is not empty %}
            <span class="cv-org">· {{ organization }}</span>
          {% endif %}
        </h1>
        <p class="meta">
          {% if period is defined and period is not empty %}
            <span class="cv-period">{{ period }}</span>
          {% elseif date is defined and date is not empty %}
            <time datetime="{{ date }}">{{ date | date("F d, Y") }}</time>
          {% endif %}
          {% if location is defined and location is not empty %}
             · {{ location }}
          {% endif %}
        </p>
      </header>

      {% if summary is defined and summary is not empty %}
        <p class="lede">{{ summary }}</p>
      {% elseif deck is defined and deck is not empty %}
        <p class="lede">{{ deck | striptags }}</p>
      {% endif %}

      {% if highlights is defined and highlights is iterable and highlights is not empty %}
        <ul class="cv-highlights">
          {% for point in highlights %}
            <li>{{ point }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if hero_image is defined and hero_image is not empty %}
        <img class="cover" src="{{ theme.contentAsset(hero_image) }}" alt="{{ hero_title }}" loading="lazy" decoding="async">
      {% endif %}

      {% for post_item in posts %}
        <div class="prose article-content traven-preview">
          {{ post_item.content_html | raw }}
        </div>
      {% endfor %}

      {{ theme.partial('faqs') | raw }}

      <section class="cv-discussion">
        {{ theme.partial('comment-thread') | raw }}
        {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
      </section>

    </article>
  </main>
</div>

{{ theme.partial('footer') | raw }}
