{{ theme.partial('head') | raw }}
<div class="page-wrapper">
    {{ theme.partial('header') | raw }}

    <main class="main-container">
        <div class="archive-list">
            {% for dossier in dossiers %}
                {% set url = theme.isStatic() ? (base_path ~ dossier.slug ~ '/index.html') : ('post.php?slug=' ~ dossier.slug ~ '&section=' ~ (dossier.section | default('blog'))) %}
                <article class="archive-item">
                    <div class="archive-meta">
                        <span class="archive-category">{{ dossier.category | default(dossier.section | default('Post')) | upper }}</span>
                        <time class="archive-date" datetime="{{ dossier.date }}">{{ dossier.date | default('') | date("j M Y") }}</time>
                    </div>
                    <h2 class="archive-title">
                        <a href="{{ url }}">{{ (dossier.hero_title | default(dossier.title)) | title }}</a>
                    </h2>
                    {% if dossier.deck is not empty %}
                        <p class="archive-deck">{{ dossier.deck | striptags }}</p>
                    {% endif %}
                    <a href="{{ url }}" class="archive-link">Read Post &rarr;</a>
                </article>
            {% else %}
                <p class="empty-feed">No matching posts found.</p>
            {% endfor %}
        </div>
    </main>

    {{ theme.partial('footer') | raw }}
</div>
