{% if posts is not empty and posts|length > 1 %}
<div class="sidebar-widget sticky-widget">
    <h3 class="sidebar-title">Table of Contents</h3>
    <ul class="sidebar-list">
        {% for post in posts %}
            {% if post.id != 'index' %}
                {% set label = post.title | default('') %}
                {% if label is empty %}
                    {% if post.id == 'intro' or post.id == 'main' %}
                        {% set label = 'Introduction' %}
                    {% else %}
                        {% set label = post.id | replace({'-': ' ', '_': ' '}) | title %}
                    {% endif %}
                {% endif %}
                <li class="sidebar-list-item">
                    <a href="#{{ post.id }}" class="sidebar-list-link">
                        {{ label }}
                    </a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
</div>
{% endif %}
