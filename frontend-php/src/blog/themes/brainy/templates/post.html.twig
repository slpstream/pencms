{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is defined and hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
{% set byline_name = author is defined ? (author is iterable ? (author.name | default(author.display_name | default(''))) : author) : '' %}
{% set zone = category | default(section | default('')) %}
{% set facet = trumpet | default(zone) %}
{% set post_list = (posts is defined and posts is not empty) ? posts : [] %}

<div id="content-wrapper">
    <main id="main">
        <header class="magazine-header">
            {% if has_hero %}
                <figure class="header-image standard-image">
                    <picture>
                        <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title | default(title | default('Hero Image')) }}">
                    </picture>
                    {% if hero_caption is defined and hero_caption is not empty %}
                        <figcaption>{{ hero_caption }}</figcaption>
                    {% endif %}
                </figure>
            {% endif %}

            <div class="header-text-content">
                {% if facet is not empty %}
                    {% if zone is not empty and (theme.isStatic() or not has_static_export|default(false)) %}
                        <a href="{{ base_path ~ (theme.isStatic() ? 'category/' ~ zone ~ '/index.html' : 'category.php?cat=' ~ zone) }}" class="trumpet">{{ facet }}</a>
                    {% else %}
                        <span class="trumpet">{{ facet }}</span>
                    {% endif %}
                {% endif %}

                <h1 class="headline">{{ hero_title | default(title | default('Untitled')) }}</h1>

                {% if deck is defined and deck is not empty %}
                    <div class="deck">{{ deck | raw }}</div>
                {% endif %}

                {% set has_dateline = dateline is defined and dateline is not empty %}
                {% set has_date = date is defined and date is not empty %}
                {% if byline_name is not empty or has_dateline or has_date %}
                    <div class="byline-container">
                        {% if byline_name is not empty %}
                            <div class="byline">
                                By <span class="byline-author">{{ byline_name }}</span>
                            </div>
                        {% endif %}
                        {% if has_dateline or has_date %}
                            <div class="timestamp-container">
                                <span class="timestamp">
                                    {% if has_dateline %}
                                        {{ dateline }}
                                    {% elseif has_date %}
                                        {{ date | date("m.d.y") }}
                                    {% endif %}
                                </span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </header>

        <div class="article-content-layout">
            <div class="article-main-column">
                {% for post in post_list %}
                    {% set fragment_id = post.id | default(loop.index) %}
                    {% set fragment_title = post.title | default('') %}
                    <article class="article-fragment" id="{{ fragment_id }}">
                        {% if fragment_title is not empty and post_list|length > 1 %}
                            <h2 class="fragment-title">{{ fragment_title }}</h2>
                        {% endif %}
                        <div class="article-content traven-preview">
                            {{ (post.content_html is defined ? post.content_html : '') | raw }}
                        </div>
                    </article>
                {% endfor %}

                {{ theme.partial('faqs') | raw }}

                <section class="brainy-discussion">
                    {{ theme.partial('comment-thread') | raw }}
                    {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
                </section>

                {{ theme.partial('sidebar-related') | raw }}
            </div>

            {% if post_list|length > 1 %}
                <aside class="sidebar-rail">
                    {{ theme.partial('sidebar-toc') | raw }}
                    {{ theme.partial('sidebar-secondary') | raw }}
                </aside>
            {% endif %}
        </div>
    </main>
</div>

{{ theme.partial('footer') | raw }}
