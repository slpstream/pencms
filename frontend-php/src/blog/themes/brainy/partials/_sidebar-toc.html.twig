{% if posts is not empty and posts|length > 1 %}
<nav class="sidebar-card toc-sidebar" aria-label="Table of Contents">
    <div class="sidebar-title">Contents</div>
    <ol class="toc-list">
        {% for post in posts %}
            {% if post.id != 'index' %}
                {% set label = post.title | default('') %}
                {% if label is empty %}
                    {% if post.id == 'intro' or post.id == 'main' %}
                        {% set label = 'Introduction' %}
                    {% else %}
                        {% set label = post.id | replace({'-': ' ', '_': ' '}) | title %}
                    {% endif %}
                {% endif %}
                <li>
                    <a href="#{{ post.id }}">{{ label }}</a>
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</nav>
{% endif %}
