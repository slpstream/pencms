{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
{% set byline = author is iterable ? (author.name | default('')) : author %}
{% set has_toc = posts is defined and posts is not empty and posts|length > 1 %}
{% set has_related = related_dossiers is defined and related_dossiers is not empty %}
{% set secondary_items = menu('secondary') %}
{% set show_yarn = has_toc or has_related or (secondary_items is not empty) %}

<main id="main" class="site-main page-post">
    <header class="page-header post-mast">
        {% if trumpet is not empty %}
            <p class="eyebrow post-detail-trumpet">{{ trumpet }}</p>
        {% elseif category is not empty %}
            <p class="eyebrow post-detail-trumpet">{{ category }}</p>
        {% endif %}
        <h1 class="post-detail-title">{{ hero_title | default(title | default('Untitled')) }}</h1>
        {% if deck is not empty %}
            <p class="lede post-detail-deck">{{ deck | striptags }}</p>
        {% endif %}
        <dl class="ticket-specs mast-specs">
            {% if byline is not empty %}
                <div><dt>Author</dt><dd>{{ byline }}</dd></div>
            {% endif %}
            {% if dateline is not empty %}
                <div><dt>Date</dt><dd><time datetime="{{ date }}">{{ dateline }}</time></dd></div>
            {% elseif date is not empty %}
                <div><dt>Date</dt><dd><time datetime="{{ date }}">{{ date | date("j F Y") }}</time></dd></div>
            {% endif %}
        </dl>
        {% if has_hero %}
            <figure class="loom-panel post-hero">
                <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
            </figure>
        {% endif %}
    </header>

    <div class="commissions-inner post-stage">
        <div class="post-prose">
            {% for post in posts %}
                <article class="post-body" id="{{ post.id }}">
                    {% if post.title is not empty and posts|length > 1 %}
                        <h2 class="fragment-title">{{ post.title }}</h2>
                    {% endif %}
                    <div class="article-content traven-preview">
                        {{ post.content_html | raw }}
                    </div>
                </article>
            {% endfor %}

            {{ theme.partial('faqs') | raw }}

            <section class="jacquard-discussion">
                {{ theme.partial('comment-thread') | raw }}
                {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
            </section>
        </div>
        {% if show_yarn %}
            <aside class="yarn-wall" aria-label="Sidebar">
                {{ theme.partial('sidebar-secondary') | raw }}
                {{ theme.partial('sidebar-toc') | raw }}
                {{ theme.partial('sidebar-related') | raw }}
            </aside>
        {% endif %}
    </div>

    {% if has_related %}
        <section class="punched" aria-labelledby="relatedHead">
            <h2 id="relatedHead">Related articles</h2>
            <ul class="punched-list">
                {% for item in related_dossiers %}
                    <li><a href="{{ contentUrl(item) }}">{{ item.hero_title | default(item.title) }}</a></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
</main>

{{ theme.partial('footer') | raw }}
