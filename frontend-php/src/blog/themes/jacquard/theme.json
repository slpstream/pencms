{
  "type": "native",
  "name": "Jacquard",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Warm serif blog with a dark header, edition banner, featured lead, and a two-up story grid. Archive listings keep ticket cards. Light default with a published light/dark toggle.",
  "editor_skin": "jacquard",
  "editor_skin_base": [],
  "color_mode": "both",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": { "type": "string", "required": true },
    "posts": { "type": "array", "required": false },
    "dossiers": { "type": "array", "required": false },
    "hero_image": { "type": "string", "required": false },
    "deck": { "type": "html", "required": false },
    "trumpet": { "type": "string", "required": false },
    "date": { "type": "string", "required": false },
    "author": { "type": "string", "required": false },
    "dateline": { "type": "string", "required": false },
    "page_title": { "type": "string", "required": false },
    "tagline": { "type": "string", "required": false },
    "og_title": { "type": "string", "required": false },
    "og_description": { "type": "string", "required": false },
    "og_image": { "type": "string", "required": false },
    "meta_description": { "type": "string", "required": false }
  },
  "style": {
    "dark_scope": {
      "selector": "html.cm-wysiwym-dark, html[data-theme=\"dark\"]"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--color-bg",
            "default": "#E7DFCC",
            "dark_default": "#101D38"
          },
          {
            "id": "text",
            "label": "Text",
            "type": "color",
            "var": "--color-text",
            "default": "#33261A",
            "dark_default": "#F6F0E1"
          },
          {
            "id": "muted",
            "label": "Muted",
            "type": "color",
            "var": "--color-muted",
            "default": "#5F5340",
            "dark_default": "#93A7CD"
          },
          {
            "id": "accent",
            "label": "Accent",
            "type": "color",
            "var": "--color-accent",
            "default": "#A63D2F",
            "dark_default": "#CD6A52"
          },
          {
            "id": "border",
            "label": "Border",
            "type": "color",
            "var": "--color-border",
            "default": "#3A2B1D",
            "dark_default": "#D8CBB2"
          },
          {
            "id": "panel",
            "label": "Panel",
            "type": "color",
            "var": "--color-panel",
            "default": "#F6F0E1",
            "dark_default": "#182B4E"
          },
          {
            "id": "warp",
            "label": "Stripe",
            "type": "color",
            "var": "--color-warp",
            "default": "#26406C",
            "dark_default": "#4B6BA0"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--font-display",
            "default": "'Besley', 'Iowan Old Style', Georgia, serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Besley', 'Iowan Old Style', Georgia, serif", "label": "Besley" },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--font-body",
            "default": "'Besley', 'Iowan Old Style', Georgia, serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Besley', 'Iowan Old Style', Georgia, serif", "label": "Besley" },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--font-mono",
            "default": "'IBM Plex Mono', 'SFMono-Regular', Menlo, monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'IBM Plex Mono', 'SFMono-Regular', Menlo, monospace", "label": "IBM Plex Mono" },
              { "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", "label": "System Mono" }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#A63D2F",
    "og_vignette_color": "#101D38",
    "og_text_color": "#F6F0E1",
    "og_bar_color": "#A63D2F",
    "og_font": "CourierPrime-Bold",
    "og_fonts": {},
    "og_headline_style": "poster",
    "og_text_case": "upper",
    "og_grade_preset": "warm",
    "og_accent_bar": true,
    "og_watermark": null,
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
