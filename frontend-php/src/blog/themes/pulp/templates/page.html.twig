{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}

<main id="main" class="site-main page-page">
    <article class="press-sheet post-sheet">
        <h1 class="page-heading post-detail-title mast-title woodcut-title" id="postWoodcut" data-name="{{ hero_title | default('Untitled') }}" aria-label="{{ hero_title | default('Untitled') }}">
            <span class="mast-title-plain">{{ hero_title }}</span>
        </h1>
        {% if deck is not empty %}
            <div class="post-detail-deck mast-strip-wrap">
                <div class="mast-strip"><span class="tape tape-l" aria-hidden="true"></span>{{ deck | striptags }}<span class="tape tape-r" aria-hidden="true"></span></div>
            </div>
        {% endif %}

        {% if has_hero %}
            <figure class="polaroid">
                <span class="tape tp-corner" aria-hidden="true"></span>
                <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
            </figure>
        {% endif %}

        <div class="post-prose">
            <div class="article-content traven-preview">
                {{ page_content | raw }}
            </div>

            {{ theme.partial('faqs') | raw }}
        </div>
    </article>
</main>

{{ theme.partial('footer') | raw }}
