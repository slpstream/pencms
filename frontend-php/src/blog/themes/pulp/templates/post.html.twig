{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
{% set byline = author is iterable ? (author.name | default('')) : author %}

<main id="main" class="site-main page-post">
    <article class="press-sheet post-sheet">
        {% if trumpet is not empty %}
            <p class="post-detail-trumpet pg-kicker">{{ trumpet }}</p>
        {% endif %}
        <h1 class="post-detail-title mast-title woodcut-title" id="postWoodcut" data-name="{{ hero_title | default('Untitled') }}" aria-label="{{ hero_title | default('Untitled') }}">
            <span class="mast-title-plain">{{ hero_title }}</span>
        </h1>
        {% if deck is not empty %}
            <div class="post-detail-deck mast-strip-wrap">
                <div class="mast-strip"><span class="tape tape-l" aria-hidden="true"></span>{{ deck | striptags }}<span class="tape tape-r" aria-hidden="true"></span></div>
            </div>
        {% endif %}
        <p class="post-meta-line">
            {% if byline is not empty %}<span>{{ byline }}</span>{% endif %}
            {% if dateline is not empty %}
                <time datetime="{{ date }}">{{ dateline }}</time>
            {% elseif date is not empty %}
                <time datetime="{{ date }}">{{ date | date("F d, Y") }}</time>
            {% endif %}
            {% if category is not empty %}<span class="card-role">{{ category }}</span>{% endif %}
        </p>

        {% if has_hero %}
            <figure class="polaroid">
                <span class="tape tp-corner" aria-hidden="true"></span>
                <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
            </figure>
        {% endif %}

        <div class="post-layout">
            <div class="post-prose">
                {% for post in posts %}
                    <div class="post-body" id="{{ post.id }}">
                        {% if post.title is not empty and posts|length > 1 %}
                            <h2 class="fragment-title">{{ post.title }}</h2>
                        {% endif %}
                        <div class="article-content traven-preview">
                            {{ post.content_html | raw }}
                        </div>
                    </div>
                {% endfor %}

                {{ theme.partial('faqs') | raw }}

                <section class="pulp-discussion">
                    {{ theme.partial('comment-thread') | raw }}
                    {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
                </section>
            </div>
            <aside class="post-stickers" aria-label="Issue furniture">
                {{ theme.partial('sidebar-toc') | raw }}
                {{ theme.partial('sidebar-related') | raw }}
            </aside>
        </div>
    </article>
</main>

{{ theme.partial('footer') | raw }}
