{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
{% set byline = author is iterable ? (author.name | default('')) : author %}
{% set has_toc = posts is defined and posts is not empty and posts|length > 1 %}
{% set has_related = related_dossiers is defined and related_dossiers is not empty %}

<main id="main" class="site-main page-post">
    <header class="post-slab wrap">
        <div class="rule" aria-hidden="true"></div>
        <div class="split post-split">
            <div class="post-type">
                {% if trumpet is not empty %}
                    <p class="cap-cat post-detail-trumpet">{{ trumpet }}</p>
                {% elseif category is not empty %}
                    <p class="cap-cat post-detail-trumpet">{{ category }}</p>
                {% endif %}
                <h1 class="grafik-title post-detail-title">{{ hero_title | default(title | default('Untitled')) }}<i class="dot" aria-hidden="true"></i></h1>
                {% if deck is not empty %}
                    <p class="post-detail-deck">{{ deck | striptags }}</p>
                {% endif %}
                <p class="post-meta">
                    {% if byline is not empty %}<span>{{ byline }}</span>{% endif %}
                    {% if byline is not empty and (dateline is not empty or date is not empty) %}
                        <span class="meta-sep" aria-hidden="true">·</span>
                    {% endif %}
                    {% if dateline is not empty %}
                        <time datetime="{{ date }}">{{ dateline }}</time>
                    {% elseif date is not empty %}
                        <time datetime="{{ date }}">{{ date | date("F j, Y") }}</time>
                    {% endif %}
                </p>
            </div>
            <div class="post-plate">
                {% if has_hero %}
                    <figure class="plate">
                        <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
                    </figure>
                {% else %}
                    <div class="plate"><span class="plate-fallback" aria-hidden="true"></span></div>
                {% endif %}
            </div>
        </div>
    </header>

    <div class="wrap post-body-wrap{% if has_toc or has_related %} post-body-wrap--split{% endif %}">
        {% if has_toc or has_related %}
            <aside class="post-peer" aria-label="Alongside">
                {{ theme.partial('sidebar-toc') | raw }}
                {{ theme.partial('sidebar-related') | raw }}
            </aside>
        {% endif %}
        <div class="post-prose">
            {% for post in posts %}
                <div class="post-body" id="{{ post.id }}">
                    {% if post.title is not empty and posts|length > 1 %}
                        <h2 class="fragment-title">{{ post.title }}</h2>
                    {% endif %}
                    <div class="article-content traven-preview">
                        {{ post.content_html | raw }}
                    </div>
                </div>
            {% endfor %}

            {{ theme.partial('faqs') | raw }}

            <section class="grafik-discussion">
                {{ theme.partial('comment-thread') | raw }}
                {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
            </section>
        </div>
    </div>
</main>

{{ theme.partial('footer') | raw }}
