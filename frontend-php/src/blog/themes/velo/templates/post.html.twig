{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
{% set byline = author is iterable ? (author.name | default('')) : author %}

<main id="main" class="site-main page-post">
    <header class="band band-oak plane post-oak">
        <div class="wrap post-oak-in">
            {% if trumpet is not empty %}
                <p class="post-detail-trumpet sec-eyebrow">{{ trumpet }}</p>
            {% elseif category is not empty %}
                <p class="post-detail-trumpet sec-eyebrow">{{ category }}</p>
            {% endif %}
            <h1 class="post-detail-title masthead">{{ hero_title | default(title | default('Untitled')) }}</h1>
            <div class="post-oak-split">
                <div class="post-oak-copy">
                    {% if deck is not empty %}
                        <div class="post-detail-deck deck">{{ deck | striptags }}</div>
                    {% endif %}
                    {% if byline is not empty or dateline is not empty or date is not empty or category is not empty %}
                        <p class="post-meta mono">
                            {% if byline is not empty %}<span>{{ byline }}</span>{% endif %}
                            {% if dateline is not empty %}
                                {% if byline is not empty %}<span class="post-meta-sep" aria-hidden="true">·</span>{% endif %}
                                <time datetime="{{ date }}">{{ dateline }}</time>
                            {% elseif date is not empty %}
                                {% if byline is not empty %}<span class="post-meta-sep" aria-hidden="true">·</span>{% endif %}
                                <time datetime="{{ date }}">{{ date | date("d M Y") }}</time>
                            {% endif %}
                            {% if category is not empty %}
                                {% if byline is not empty or dateline is not empty or date is not empty %}<span class="post-meta-sep" aria-hidden="true">·</span>{% endif %}
                                <span>{{ category }}</span>
                            {% endif %}
                        </p>
                    {% endif %}
                </div>
                {{ theme.partial('sidebar-secondary') | raw }}
            </div>
        </div>
    </header>

    {% if has_hero %}
        <figure class="post-hero-cut">
            <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
        </figure>
    {% endif %}

    <div class="band band-cream band-wedges{% if has_hero %} band--after-hero{% endif %}">
        <div class="wrap post-body-wrap">
            <div class="post-prose">
                {{ theme.partial('sidebar-toc') | raw }}
                {% for post in posts %}
                    <div class="post-body" id="{{ post.id }}">
                        {% if post.title is not empty and posts|length > 1 %}
                            <h2 class="fragment-title">{{ post.title }}</h2>
                        {% endif %}
                        <div class="article-content traven-preview">
                            {{ post.content_html | raw }}
                        </div>
                    </div>
                {% endfor %}

                {{ theme.partial('faqs') | raw }}

                <section class="velo-discussion">
                    {{ theme.partial('comment-thread') | raw }}
                    {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
                </section>
            </div>
        </div>
    </div>

    {% if related_dossiers is defined and related_dossiers is not empty %}
        <section class="band band-cream band-wedges band-riders plane">
            <div class="wrap">
                {{ theme.partial('sidebar-related') | raw }}
            </div>
        </section>
    {% endif %}
</main>

{{ theme.partial('footer') | raw }}
