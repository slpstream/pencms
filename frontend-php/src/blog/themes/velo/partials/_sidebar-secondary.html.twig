{% set secondary_items = menu('secondary') %}
{% if secondary_items is not empty %}
<aside class="hero-hud hud-nav" aria-label="Secondary">
    <ul class="hud-list">
        {% for item in secondary_items %}
            <li class="hud-row{% if item.children is not empty %} has-children{% endif %}">
                {% if item.target_type == 'label' %}
                    <span class="hud-k">{{ item.label }}</span>
                {% else %}
                    <a href="{{ item.url }}" class="hud-v"{% if item.open_in_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
                {% endif %}
                {% if item.children is not empty %}
                    <ul class="hud-children">
                        {% for child in item.children %}
                            <li>
                                {% if child.target_type == 'label' %}
                                    <span class="hud-k">{{ child.label }}</span>
                                {% else %}
                                    <a href="{{ child.url }}" class="hud-v"{% if child.open_in_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</aside>
{% endif %}
