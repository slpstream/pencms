{% if related_dossiers is not empty %}
<aside class="peer-related" aria-label="Related">
    <p class="peer-kicker mono">RELATED</p>
    <ul class="riders riders--related">
        {% for post in related_dossiers %}
            {% set url = contentUrl(post) %}
            {% set has_hero = post.hero_image is not empty and post.hero_image != 'images/defaulthero.jpg' %}
            <li class="rider">
                {% if has_hero %}
                    <a href="{{ url }}" class="rider-mark">
                        <img src="{{ contentAsset(post.hero_image) }}" alt="" loading="lazy" decoding="async">
                    </a>
                {% endif %}
                <p class="rider-no mono">Nº {{ loop.index }}</p>
                <h3 class="rider-name"><a href="{{ url }}">{{ post.hero_title | default(post.title) }}</a></h3>
                {% if post.trumpet is not empty %}
                    <p class="rider-club mono">{{ post.trumpet | striptags }}</p>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</aside>
{% endif %}
