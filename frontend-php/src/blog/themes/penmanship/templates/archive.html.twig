{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-content">

<section class="hero-banner">
    <h1 class="hero-title-text">Category: {{ hero_title | default('') | title }}</h1>
    <p class="hero-tagline-text">Posts matching the category.</p>
</section>

{% set secondary_items = menu('secondary') %}
<div class="main-container{% if secondary_items is empty %} main-container-narrow{% endif %}">
    <div class="{% if secondary_items is not empty %}layout-grid layout-grid-with-nav" style="max-width:1120px;margin:0 auto;padding:0 24px 48px;"{% else %}feed-posts-wrap"{% endif %}>
        {% if secondary_items is not empty %}
            <aside class="sidebar-column sidebar-column-nav">
                {{ theme.partial('sidebar-secondary') | raw }}
            </aside>
        {% endif %}

        <div class="feed-posts">
            {% for dossier in dossiers | default([]) %}
                {% set url = theme.isStatic() ? ((base_path | default('')) ~ dossier.slug ~ '/index.html') : ('post.php?slug=' ~ dossier.slug ~ '&section=' ~ (dossier.section | default('blog'))) %}
                <article class="post-card {% if dossier.category is defined and dossier.category is not empty %}theme-{{ dossier.category }}{% endif %}">
                    <div class="post-card-meta">
                        <time datetime="{{ dossier.date | default('') }}">{{ dossier.date | default('') | date("F d, Y") }}</time>
                    </div>
                    
                    <h2 class="post-card-title">
                        <a href="{{ url }}">{{ dossier.hero_title | default(dossier.title | default('')) }}</a>
                    </h2>
                    
                    {% if dossier.deck is defined and dossier.deck is not empty %}
                        <p class="post-card-deck"><a href="{{ url }}">{{ dossier.deck | striptags }}</a></p>
                    {% endif %}
                </article>
            {% else %}
                <div class="post-card">
                    <p class="italic text-center" style="color:var(--traven-muted);font-style:italic;text-align:center;">No matching posts found.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

</main>

{{ theme.partial('footer') | raw }}
