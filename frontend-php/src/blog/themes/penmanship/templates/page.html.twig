{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-content">

  {% set secondary_items = menu('secondary') %}
  {% set has_hero = hero_image is defined and hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}

  {% if has_hero %}
  <!-- Page Header with Hero Image -->
  <header class="post-header-outer">
    <div class="hero-image-wrapper">
      <div class="hero-image-container">
        <div class="hero-image-gradient"></div>
        <img alt="" loading="lazy" class="hero-image" src="{{ contentAsset(hero_image) }}">
      </div>
    </div>
  </header>
  {% endif %}

  {% if has_hero %}
  <!-- With hero image: full bleed hero banner with title overlaying -->
  <div class="{% if secondary_items is not empty %}layout-grid layout-grid-with-nav" style="max-width:1120px;margin:0 auto;padding:0 24px 48px;"{% else %}post-body-container" style="padding-top:0;"{% endif %}>
    {% if secondary_items is not empty %}
    <aside class="sidebar-column sidebar-column-nav">
      {{ theme.partial('sidebar-secondary') | raw }}
    </aside>
    {% endif %}

    <div class="post-main-column">
      <header class="penmanship-post-header">
        <div class="post-header-inner" style="margin-top:-80px;position:relative;z-index:2;">
          <div class="post-meta">
            <h1 class="post-title">{{ hero_title | default(title | default('')) }}</h1>
            {% if deck is defined and deck is not empty %}
              <p class="post-deck">{{ deck | raw }}</p>
            {% endif %}
          </div>
        </div>
      </header>

      <div class="post-content-wrapper" style="padding-top:24px;" id="post-content">
        <article class="post-body">
          <div class="article-content traven-preview">
            {{ page_content | default('') | raw }}
          </div>
        </article>

        {{ theme.partial('faqs') | raw }}
      </div>
    </div>
  </div>

  {% else %}
  <!-- No hero image: blank line top padding so title doesn't hug navbar -->
  <div class="{% if secondary_items is not empty %}layout-grid layout-grid-with-nav" style="max-width:1120px;margin:0 auto;padding:32px 24px 48px;"{% else %}post-body-container" style="padding-top:32px;"{% endif %}>
    {% if secondary_items is not empty %}
    <aside class="sidebar-column sidebar-column-nav">
      {{ theme.partial('sidebar-secondary') | raw }}
    </aside>
    {% endif %}

    <div class="post-main-column">
      <header class="penmanship-post-header">
        <h1 class="post-detail-title">{{ hero_title | default(title | default('')) }}</h1>
        {% if deck is defined and deck is not empty %}
          <div class="post-detail-deck">{{ deck | raw }}</div>
        {% endif %}
      </header>

      <article class="post-body">
        <div class="article-content traven-preview">
          {{ page_content | default('') | raw }}
        </div>
      </article>

      {{ theme.partial('faqs') | raw }}
    </div>
  </div>
  {% endif %}

</main>

{{ theme.partial('footer') | raw }}
