{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-content">

<section class="hero-banner">
    <h1 class="hero-title-text">{{ hero_title | default('Search') }}</h1>
    <p class="hero-tagline-text">Find posts and pages on this site.</p>
</section>

{% set secondary_items = menu('secondary') %}
<div class="main-container{% if secondary_items is empty %} main-container-narrow{% endif %}">
    <div class="{% if secondary_items is not empty %}layout-grid layout-grid-with-nav" style="max-width:1120px;margin:0 auto;padding:0 24px 48px;"{% else %}feed-posts-wrap"{% endif %}>
        {% if secondary_items is not empty %}
            <aside class="sidebar-column sidebar-column-nav">
                {{ theme.partial('sidebar-secondary') | raw }}
            </aside>
        {% endif %}

        <div class="feed-posts">
            <div
                id="pencms-search"
                class="pencms-search"
                data-search-index-url="{{ search_index_url | default('') }}"
                data-static="{{ theme.isStatic() ? '1' : '0' }}"
                data-base-path="{{ base_path | default('') }}"
                data-web-root="{{ base_path | default('') }}"
            >
                <label class="search-label" for="search-input">Search</label>
                <input
                    type="search"
                    id="search-input"
                    class="search-input"
                    name="q"
                    placeholder="Search posts and pages…"
                    autocomplete="off"
                    enterkeyhint="search"
                >

                {% if search_index_json is defined and search_index_json is not null %}
                <script type="application/json" id="search-index-data">{{ search_index_json | raw }}</script>
                {% endif %}

                <div id="search-results" class="search-results" aria-live="polite"></div>
            </div>
        </div>
    </div>
</div>

<script src="{{ publicAsset('vendor/minisearch/minisearch.min.js') }}"></script>
<script src="{{ publicAsset('vendor/minisearch/search-ui.js') }}"></script>

</main>

{{ theme.partial('footer') | raw }}
