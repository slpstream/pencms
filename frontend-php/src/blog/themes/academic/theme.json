{
  "type": "native",
  "name": "Academic",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Classic LaTeX Booktabs theme — cream paper, ink, and oxblood with Computer Modern / Source Serif reading stack. Light and Dark modes with toggle.",
  "editor_skin": "academic",
  "color_mode": "both",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "dark_scope": {
      "selector": ".cm-wysiwym-dark"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--traven-bg",
            "default": "#faf8f2",
            "dark_default": "#22201c"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--traven-text",
            "default": "#1c1b17",
            "dark_default": "#e6e1d5"
          },
          {
            "id": "headings",
            "label": "Headings",
            "type": "color",
            "var": "--traven-h-color",
            "default": "#1c1b17",
            "dark_default": "#f2ede1"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--traven-caret",
            "default": "#7a2226",
            "dark_default": "#e07070"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--traven-muted",
            "default": "#7d776a",
            "dark_default": "#948e81"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--traven-border",
            "default": "#d9d3c2",
            "dark_default": "#4d463b"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--traven-font-display",
            "default": "\"Computer Modern Serif\", \"Source Serif 4\", Georgia, Cambria, \"Times New Roman\", Times, serif",
            "options": [
              { "value": "", "label": "Theme default" },
              {
                "value": "\"Computer Modern Serif\", \"Source Serif 4\", Georgia, Cambria, \"Times New Roman\", Times, serif",
                "label": "Computer Modern Serif"
              },
              { "value": "'Playfair Display', serif", "label": "Playfair Display" },
              { "value": "'Roboto', sans-serif", "label": "Roboto" },
              { "value": "'Inter', sans-serif", "label": "Inter" },
              { "value": "'Outfit', sans-serif", "label": "Outfit" },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--traven-font-body",
            "default": "\"Computer Modern Serif\", \"Source Serif 4\", Georgia, Cambria, \"Times New Roman\", Times, serif",
            "options": [
              { "value": "", "label": "Theme default" },
              {
                "value": "\"Computer Modern Serif\", \"Source Serif 4\", Georgia, Cambria, \"Times New Roman\", Times, serif",
                "label": "Computer Modern Serif"
              },
              { "value": "'Playfair Display', serif", "label": "Playfair Display" },
              { "value": "'Roboto', sans-serif", "label": "Roboto" },
              { "value": "'Inter', sans-serif", "label": "Inter" },
              { "value": "'Outfit', sans-serif", "label": "Outfit" },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--traven-font-mono",
            "default": "\"Computer Modern Typewriter\", \"Courier Prime\", \"Courier New\", Courier, monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              {
                "value": "\"Computer Modern Typewriter\", \"Courier Prime\", \"Courier New\", Courier, monospace",
                "label": "Computer Modern Typewriter"
              },
              { "value": "'Fira Code', monospace", "label": "Fira Code" },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#7a2226",
    "og_vignette_color": "#7d776a",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#1c1b17",
    "og_font": "CMUSerif-Bold",
    "og_fonts": {
      "CMUSerif-Bold": "assets/fonts/CMUSerif-Bold.ttf",
      "CMUSerif-Regular": "assets/fonts/CMUSerif-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": "assets/images/watermark.png",
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
