<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <script>
    (function () {
      try {
        var mode = localStorage.getItem('manual-color-scheme');
        if (mode === 'dark' || mode === 'light') document.documentElement.dataset.theme = mode;
      } catch (error) {
        /* Private browsing or disabled storage: keep the light default. */
      }
    }());
  </script>
  <title>{% if hero_title is not empty and sitename is not empty and hero_title != sitename %}{{ hero_title }} | {{ sitename }}{% else %}{{ hero_title | default(sitename) }}{% endif %}</title>
  <meta name="description" content="{{ meta_description | default(tagline | default('Manual documentation.')) }}">
  {% if keywords is defined and keywords is not empty %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <meta property="og:type" content="website"><meta property="og:url" content="{{ canonical_url | default('') }}">
  <meta property="og:title" content="{{ og_title | default(og_title_fallback | default(page_title | default(sitename))) }}">
  <meta property="og:description" content="{{ og_description | default(og_description_fallback | default(meta_description | default(''))) }}">
  {% set abs_og_image = og_image | default(og_default_image | default('images/defaulthero.jpg')) %}
  {% if not (abs_og_image matches '/^https?:\\/\\//') %}{% set abs_og_image = contentAsset(abs_og_image) %}{% endif %}
  <meta property="og:image" content="{{ abs_og_image }}"><meta name="twitter:card" content="{{ twitter_card | default('summary_large_image') }}">
  {# Shared font registry (Style Settings + identity faces) #}
  <link rel="stylesheet" href="{{ publicAsset('fonts/fonts.css') }}">
  {{ theme.linkCss('css/skin-manual.css') | raw }}
  {{ theme.linkCss('css/styles.css') | raw }}
  <link rel="stylesheet" href="{{ publicAsset('vendor/katex/katex.min.css') }}">
  <link rel="stylesheet" href="{{ publicAsset('vendor/traven/expand-embed.css') }}">
  <script type="module" src="{{ publicAsset('vendor/traven/expand-embed-runtime.js') }}"></script>
  <link rel="alternate" type="application/rss+xml" title="{{ sitename | default('RSS') }}" href="{{ base_path }}feed.xml">
</head>
<body class="traven-preview {{ body_class|default('') }}">
<a class="skip-link" href="#main">Skip to content</a>
