{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}
<main id="main" class="container">
  <article class="page">
    <header class="page-header">
      <h1>{{ hero_title }}</h1>
      {% if deck is not empty %}<p class="lede">{{ deck | raw }}</p>{% endif %}
    </header>
    <div class="article-content traven-preview">{{ page_content | raw }}</div>

    {{ theme.partial('faqs') | raw }}
  </article>
</main>
{{ theme.partial('footer') | raw }}
