{% if related_dossiers is defined and related_dossiers is not empty %}
<div class="sidebar-widget sidebar-related-widget">
    <h3 class="sidebar-title">Related Stories</h3>
    <ul class="sidebar-list">
        {% for post in related_dossiers %}
            {% set url = theme.isStatic() ? (base_path ~ post.slug ~ '/index.html') : ('post.php?slug=' ~ post.slug ~ '&section=' ~ (post.section | default('blog'))) %}
            {% set has_thumb = post.hero_image is defined and post.hero_image is not empty and post.hero_image != 'images/defaulthero.png' and post.hero_image != 'images/defaulthero.jpg' %}
            <li class="sidebar-list-item">
                <a href="{{ url }}" class="sidebar-list-link">
                    {% if has_thumb %}
                        <img src="{{ theme.contentAsset(post.hero_image) }}" alt="" class="sidebar-thumb" loading="lazy">
                    {% endif %}
                    <span class="sidebar-list-title">{{ post.hero_title | default(post.title | default('Untitled')) }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
</div>
{% endif %}
