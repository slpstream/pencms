<!DOCTYPE html>
<html lang="{{ site_language | default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ seo_title | default(page_title | default(sitename)) }}</title>
    
    {% if seo_description | default(false) %}
    <meta name="description" content="{{ seo_description }}">
    {% endif %}

    <meta property="og:title" content="{{ seo_title | default(page_title | default(sitename)) }}">
    {% if seo_description | default(false) %}
    <meta property="og:description" content="{{ seo_description }}">
    {% endif %}
    <meta property="og:type" content="{% if post is defined and post %}article{% else %}website{% endif %}">
    {% if hero_image | default(false) %}
    <meta property="og:image" content="{{ theme.contentAsset(hero_image) }}">
    <meta name="twitter:card" content="summary_large_image">
    {% endif %}

    <meta name="color-scheme" content="light dark">

    {# Prevent theme flash on load #}
    <script>
        (function() {
            let scheme = null;
            try {
                scheme = localStorage.getItem('color-scheme') || localStorage.getItem('theme');
            } catch (e) {}
            if (!scheme) {
                try {
                    const match = document.cookie.match(/(^|;)\s*(?:color-scheme|theme)\s*=\s*([^;]+)/);
                    scheme = match ? match[2] : null;
                } catch (e) {}
            }
            if (scheme === 'dark' || (!scheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else if (scheme === 'light') {
                document.documentElement.classList.remove('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>

    <link rel="stylesheet" href="{{ publicAsset('fonts/fonts.css') }}">
    {{ theme.linkCss('css/styles.css') | raw }}
    {{ theme.linkCss('css/skin-gazette.css') | raw }}

    {# Expand / Embed Nutshell Runtime #}
    <link rel="stylesheet" href="{{ publicAsset('vendor/traven/expand-embed.css') }}">
    <script type="module" src="{{ publicAsset('vendor/traven/expand-embed-runtime.js') }}"></script>

    {# KaTeX Math Stylesheet #}
    <link rel="stylesheet" href="{{ publicAsset('vendor/katex/katex.min.css') }}">
</head>
<body class="{% if is_content | default(false) %}traven-preview{% endif %}">
    <a class="skip-link" href="#main">Skip to content</a>
