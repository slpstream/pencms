{
  "type": "native",
  "name": "Gazette",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "A modern digital newsroom theme for local papers and topical magazines.",
  "editor_skin": "gazette",
  "color_mode": "both",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": false,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "dark_scope": {
      "selector": "html.cm-wysiwym-dark, html[data-theme=\"dark\"]"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--color-bg",
            "default": "#fdfdfb",
            "dark_default": "#16181d"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--color-text",
            "default": "#15181d",
            "dark_default": "#eceef1"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--color-accent",
            "default": "#0b53c4",
            "dark_default": "#8fb4f4"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--color-muted",
            "default": "#555c66",
            "dark_default": "#a4adba"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--color-border",
            "default": "#e3e5e8",
            "dark_default": "#2e323a"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--font-sans",
            "default": "'Playfair Display', serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--font-serif",
            "default": "'Playfair Display', serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--font-mono",
            "default": "ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, 'Liberation Mono', monospace",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Fira Code', monospace",
                "label": "Fira Code"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, 'Liberation Mono', monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#0b53c4",
    "og_vignette_color": "#555c66",
    "og_text_color": "#15181d",
    "og_bar_color": "#fdfdfb",
    "og_font": "PlayfairDisplay-Bold",
    "og_fonts": {
      "PlayfairDisplay-Bold": "assets/fonts/PlayfairDisplay-Bold.ttf",
      "PlayfairDisplay-Regular": "assets/fonts/PlayfairDisplay-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": null,
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
