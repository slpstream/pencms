{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
    <article class="post">
        <header class="page-header">
            {% if date is defined and date %}
                <p class="post-date"><time datetime="{{ date }}">{{ date | date("F d, Y") }}</time></p>
            {% endif %}
            <h1>{{ hero_title | default(page_title | default('')) }}</h1>
            {% if deck is defined and deck %}
                <p class="lede">{{ deck | striptags }}</p>
            {% endif %}
        </header>

        {% if hero_image is defined and hero_image %}
            <img class="cover" src="{{ contentAsset(hero_image) }}" alt="" loading="lazy" decoding="async">
        {% endif %}

        {% if posts is defined and posts is not empty %}
            {% for post in posts %}
                <div class="article-content traven-preview">{{ post.content_html | raw }}</div>
            {% endfor %}
        {% else %}
            {% if content_html is defined %}
                <div class="article-content traven-preview">{{ content_html | raw }}</div>
            {% endif %}
        {% endif %}

        {{ theme.partial('faqs') | raw }}

        <section class="practice-discussion">
            {{ theme.partial('comment-thread') | raw }}
            {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
        </section>
    </article>
</main>

{{ theme.partial('footer') | raw }}
