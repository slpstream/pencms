{
  "type": "native",
  "name": "International",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Editorial magazine theme: warm stone parchment canvas, Epunda Slab serif headlines, Hubot Sans body, narrow reading column, numbered article listings, and a dark inverted footer. Light default with a published light/dark toggle.",
  "editor_skin": "international",
  "editor_skin_base": [],
  "color_mode": "both",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": false,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": { "type": "string", "required": true },
    "posts": { "type": "array", "required": false },
    "dossiers": { "type": "array", "required": false },
    "hero_image": { "type": "string", "required": false },
    "deck": { "type": "html", "required": false },
    "trumpet": { "type": "string", "required": false },
    "date": { "type": "string", "required": false },
    "author": { "type": "string", "required": false },
    "dateline": { "type": "string", "required": false },
    "page_title": { "type": "string", "required": false },
    "tagline": { "type": "string", "required": false },
    "og_title": { "type": "string", "required": false },
    "og_description": { "type": "string", "required": false },
    "og_image": { "type": "string", "required": false },
    "meta_description": { "type": "string", "required": false }
  },
  "style": {
    "dark_scope": {
      "selector": "html.cm-wysiwym-dark, html[data-theme=\"dark\"]"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Canvas / Background",
            "type": "color",
            "var": "--color-bg",
            "default": "#f6f5f4",
            "dark_default": "#161616"
          },
          {
            "id": "surface",
            "label": "Surface / Card",
            "type": "color",
            "var": "--color-surface",
            "default": "#FFFFFF",
            "dark_default": "#1E1E1E"
          },
          {
            "id": "text",
            "label": "Ink / Text",
            "type": "color",
            "var": "--color-text",
            "default": "#1A1A1A",
            "dark_default": "#E8E0D4"
          },
          {
            "id": "muted",
            "label": "Muted / Secondary",
            "type": "color",
            "var": "--color-muted",
            "default": "#6B6560",
            "dark_default": "#9B9590"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--color-accent",
            "default": "#C44B3F",
            "dark_default": "#E06B5F"
          },
          {
            "id": "border",
            "label": "Borders / Rules",
            "type": "color",
            "var": "--color-border",
            "default": "#D1C8BC",
            "dark_default": "#3A3530"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display / Heading Font",
            "type": "select",
            "var": "--font-display",
            "default": "'Epunda Slab', Georgia, 'Times New Roman', serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Epunda Slab', Georgia, 'Times New Roman', serif", "label": "Epunda Slab" },
              { "value": "'Newsreader', Georgia, 'Times New Roman', serif", "label": "Newsreader" },
              { "value": "'Playfair Display', Georgia, serif", "label": "Playfair Display" },
              { "value": "'Lora', Georgia, serif", "label": "Lora" },
              { "value": "'Source Serif 4', Georgia, serif", "label": "Source Serif 4" },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--font-body",
            "default": "'Hubot Sans', system-ui, -apple-system, sans-serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Hubot Sans', system-ui, -apple-system, sans-serif", "label": "Hubot Sans" },
              { "value": "'Inter', system-ui, -apple-system, sans-serif", "label": "Inter" },
              { "value": "'DM Sans', system-ui, sans-serif", "label": "DM Sans" },
              { "value": "'Newsreader', Georgia, serif", "label": "Newsreader" },
              { "value": "system-ui, -apple-system, BlinkMacSystemFont, sans-serif", "label": "System" }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--font-mono",
            "default": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "label": "JetBrains Mono" },
              { "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", "label": "System Mono" }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#C44B3F",
    "og_vignette_color": "#1A1A1A",
    "og_text_color": "#E8E0D4",
    "og_bar_color": "#1A1A1A",
    "og_font": "EpundaSlab-Bold",
    "og_fonts": {
      "EpundaSlab-Bold": "assets/fonts/EpundaSlab-Bold.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "paper",
    "og_accent_bar": true,
    "og_watermark": null,
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
