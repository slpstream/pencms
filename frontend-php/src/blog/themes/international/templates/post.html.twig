{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
{% set byline = author is iterable ? (author.name | default('')) : author %}
{% set has_toc = posts is defined and posts is not empty and posts|length > 1 %}
{% set has_related = related_dossiers is defined and related_dossiers is not empty %}

<main id="main" class="site-main page-post">
    <article class="post-container wrap">
        <header class="post-header">
            {% if trumpet is not empty %}
                <p class="post-trumpet">{{ trumpet }}</p>
            {% elseif category is not empty %}
                <p class="post-trumpet">{{ category }}</p>
            {% endif %}

            <h1 class="post-title">{{ hero_title | default(title | default('Untitled')) }}</h1>

            {% if deck is not empty %}
                <p class="post-deck">{{ deck | striptags }}</p>
            {% endif %}

            <div class="post-meta">
                {% if byline is not empty %}
                    <span class="post-author">{{ byline }}</span>
                {% endif %}
                {% if byline is not empty and (dateline is not empty or date is not empty) %}
                    <span class="meta-sep" aria-hidden="true">·</span>
                {% endif %}
                {% if dateline is not empty %}
                    <time datetime="{{ date }}" class="post-date">{{ dateline }}</time>
                {% elseif date is not empty %}
                    <time datetime="{{ date }}" class="post-date">{{ date | date("F j, Y") }}</time>
                {% endif %}
            </div>

            {% if has_hero %}
                <figure class="post-hero-media">
                    <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
                </figure>
            {% endif %}
        </header>

        <div class="post-body-layout{% if has_toc or has_related %} post-body-layout--with-sidebar{% endif %}">
            {% if has_toc or has_related %}
                <aside class="post-sidebar" aria-label="Article navigation">
                    {{ theme.partial('sidebar-toc') | raw }}
                    {{ theme.partial('sidebar-related') | raw }}
                </aside>
            {% endif %}

            <div class="post-prose">
                {% for post in posts %}
                    <section class="post-fragment" id="{{ post.id }}">
                        {% if post.title is not empty and posts|length > 1 %}
                            <h2 class="fragment-title">{{ post.title }}</h2>
                        {% endif %}
                        <div class="article-content traven-preview">
                            {{ post.content_html | raw }}
                        </div>
                    </section>
                {% endfor %}

                {{ theme.partial('faqs') | raw }}

                <section class="international-discussion">
                    {{ theme.partial('comment-thread') | raw }}
                    {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
                </section>
            </div>
        </div>
    </article>
</main>

{{ theme.partial('footer') | raw }}
