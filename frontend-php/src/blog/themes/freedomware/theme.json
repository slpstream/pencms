{
  "type": "native",
  "name": "Freedomware",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Freedomware — monospace FOSS publication theme. Inspired by freedomware.dev",
  "editor_skin": "freedomware",
  "color_mode": "both",
  "editor_skin_base": [],
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": false,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "dark_scope": {
      "selector": "html.cm-wysiwym-dark"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--fw-bg",
            "default": "#ffffff",
            "dark_default": "#000000"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--fw-color",
            "default": "#000000",
            "dark_default": "#ffffff"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--fw-muted",
            "default": "#555555",
            "dark_default": "#aaaaaa"
          },
          {
            "id": "code-bg",
            "label": "Code Background",
            "type": "color",
            "var": "--fw-code-bg",
            "default": "#f0f0f0",
            "dark_default": "#111111"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--fw-font-display",
            "default": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              {
                "value": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
                "label": "JetBrains Mono"
              },
              {
                "value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, \"Liberation Mono\", monospace",
                "label": "System Mono"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--fw-font-body",
            "default": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              {
                "value": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
                "label": "JetBrains Mono"
              },
              {
                "value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, \"Liberation Mono\", monospace",
                "label": "System Mono"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--fw-font-mono",
            "default": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              {
                "value": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
                "label": "JetBrains Mono"
              },
              {
                "value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, \"Liberation Mono\", monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#000000",
    "og_vignette_color": "#000000",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#000000",
    "og_font": "JetBrainsMono-Bold",
    "og_fonts": {
      "JetBrainsMono-Bold": "assets/fonts/JetBrainsMono-Bold.ttf",
      "JetBrainsMono-Regular": "assets/fonts/JetBrainsMono-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "upper",
    "og_grade_preset": "noir",
    "og_accent_bar": true,
    "og_watermark": null,
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "UNTITLED",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
