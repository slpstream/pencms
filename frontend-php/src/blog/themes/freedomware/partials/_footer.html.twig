<footer class="site-footer">
    <div class="footer-container">
        {% set footer_items = menu('footer') %}
        {% if footer_items is not empty %}
            <table class="footer-menu-table">
                <tbody>
                    <tr>
                        {% for item in footer_items %}
                            <td class="footer-menu-cell">
                                {% if item.target_type == 'label' %}
                                    <span class="footer-cell-heading">{{ item.label }}</span>
                                {% else %}
                                    <a href="{{ item.url }}" class="footer-cell-heading footer-menu-heading-link" {% if item.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
                                {% endif %}
                                {% if item.children is not empty %}
                                    <ul class="footer-menu-list">
                                        {% for child in item.children %}
                                            <li>
                                                {% if child.target_type == 'label' %}
                                                    <span class="footer-menu-label-child">{{ child.label }}</span>
                                                {% else %}
                                                    <a href="{{ child.url }}" class="footer-menu-link" {% if child.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        {% endif %}

        <table class="footer-meta-table">
            <tbody>
                <tr>
                    <th>Site</th>
                    <td class="footer-brand-cell">
                        <a href="{{ base_path }}" class="footer-brand-link">
                            {% set logo = theme.getLogoUrl() %}
                            {% if logo is not empty %}
                                <img src="{{ logo }}" alt="" class="site-logo footer-logo" aria-hidden="true">
                            {% endif %}
                            <span class="footer-site-title">{{ sitename }}</span>
                        </a>
                        {% if tagline is not empty %}
                            <span class="footer-site-tagline">{{ tagline }}</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Stack</th>
                    <td class="footer-credits"><a href="https://pencms.org/">PenCMS</a> &bull; Freedomware Theme</td>
                </tr>
            </tbody>
        </table>
    </div>
</footer>

<script src="{{ theme.asset('js/theme.js') }}"></script>

{# KaTeX Auto-Render Math Scripts #}
<script src="{{ publicAsset('vendor/katex/katex.min.js') }}"></script>
<script src="{{ publicAsset('vendor/katex/contrib/auto-render.min.js') }}"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        renderMathInElement(document.body, {
            delimiters: [
                {left: '$$', right: '$$', display: true},
                {left: '$', right: '$', display: false},
                {left: '\\(', right: '\\)', display: false},
                {left: '\\[', right: '\\]', display: true}
            ],
            throwOnError: false
        });
    });
</script>

{# Mermaid Loader & Renderer #}
<script src="{{ publicAsset('vendor/mermaid/mermaid.min.js') }}"></script>
<script>
    document.querySelectorAll('pre code.language-mermaid').forEach(function(codeBlock) {
        const pre = codeBlock.parentNode;
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = codeBlock.textContent;
        pre.replaceWith(div);
    });
    mermaid.initialize({
        startOnLoad: true,
        theme: document.documentElement.classList.contains('cm-wysiwym-dark') ? 'dark' : 'default'
    });
</script>
</body>
</html>
