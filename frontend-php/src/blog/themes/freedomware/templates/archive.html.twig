{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-container">
    <h1 class="page-heading">{{ hero_title | default('ARCHIVE') }}</h1>
    <hr class="section-divider">

    <div class="post-list">
        {% for item in dossiers %}
            {% set url = theme.isStatic() ? (base_path ~ item.slug ~ '/index.html') : ('post.php?slug=' ~ item.slug ~ '&section=' ~ (item.section | default('blog'))) %}
            <div class="post-card">
                <div class="post-card-header">
                    <span class="post-card-badge">{{ item.category | default(item.section | default('POST')) | upper }}</span>
                    <span class="post-card-meta">{{ item.date | default('') | date("Y-m-d") }}</span>
                </div>
                <h2 class="post-card-title">
                    <a href="{{ url }}">{{ item.hero_title | default(item.title) }}</a>
                </h2>
                {% if item.deck is not empty %}
                    <p class="post-card-deck">{{ item.deck | striptags }}</p>
                {% endif %}
                <div class="post-card-footer">
                    <a href="{{ url }}" class="post-card-link">READ &rarr;</a>
                </div>
            </div>
        {% else %}
            <div class="post-card">
                <p class="post-card-empty">NO POSTS FOUND</p>
            </div>
        {% endfor %}
    </div>
</main>

{{ theme.partial('footer') | raw }}
