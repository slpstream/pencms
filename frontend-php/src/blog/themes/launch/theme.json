{
  "type": "native",
  "name": "Launch",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "SaaS marketing theme. Product hero with browser mockup frame and optional partials: feature cards grid, pricing section, testimonials, FAQ, release tags.",
  "editor_skin": "launch",
  "color_mode": "both",
  "editor_skin_base": [],
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "page_content": {
      "type": "html",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "dark_scope": {
      "selector": "html.cm-wysiwym-dark, html[data-theme=\"dark\"]"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--color-bg",
            "default": "#fafafb",
            "dark_default": "#16181c"
          },
          {
            "id": "panel",
            "label": "Panel / Card",
            "type": "color",
            "var": "--color-panel",
            "default": "#ffffff",
            "dark_default": "#1d2025"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--color-text",
            "default": "#1f2226",
            "dark_default": "#e7e8ea"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--color-muted",
            "default": "#5b6069",
            "dark_default": "#a2a7b0"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--color-accent",
            "default": "#4f46e5",
            "dark_default": "#a5b4fc"
          },
          {
            "id": "primary",
            "label": "Primary CTA",
            "type": "color",
            "var": "--color-primary",
            "default": "#4f46e5",
            "dark_default": "#6366f1"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--color-border",
            "default": "#e4e5e9",
            "dark_default": "#2c3036"
          },
          {
            "id": "improved",
            "label": "Changelog Improved",
            "type": "color",
            "var": "--color-improved",
            "default": "#0e7490",
            "dark_default": "#67e8f9"
          },
          {
            "id": "fixed",
            "label": "Changelog Fixed",
            "type": "color",
            "var": "--color-fixed",
            "default": "#a16207",
            "dark_default": "#fcd34d"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--font-display",
            "default": "'Space Grotesk', sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Space Grotesk', sans-serif",
                "label": "Space Grotesk"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--font-body",
            "default": "'Space Grotesk', sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Space Grotesk', sans-serif",
                "label": "Space Grotesk"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--font-mono",
            "default": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, \"Liberation Mono\", monospace",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, \"Liberation Mono\", monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#4F46E5",
    "og_vignette_color": "#1F2226",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#16181C",
    "og_font": "SpaceGrotesk-Bold",
    "og_fonts": {
      "SpaceGrotesk-Bold": "assets/fonts/SpaceGrotesk-Bold.ttf",
      "SpaceGrotesk-Regular": "assets/fonts/SpaceGrotesk-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": null,
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
