{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
  <section class="changelog">
    <header class="page-header">
      <h1>{{ (hero_title | default('Changelog')) | title }}</h1>
      <p class="lede">Every release, in order. Proof of life.</p>
    </header>

    {% if dossiers is defined and dossiers is not empty %}
    <ol class="timeline" reversed>
      {% for item in dossiers %}
        {% set url = theme.isStatic() ? (base_path ~ item.slug ~ '/index.html') : ('post.php?slug=' ~ item.slug ~ '&section=' ~ (item.section | default('blog'))) %}
      <li class="release-item" data-tag="{{ item.tag | default('New') }}">
        <p class="release-meta">
          {% if item.date is defined and item.date is not empty %}
          <time datetime="{{ item.date }}">{{ item.date | date("M d, Y") }}</time>
          {% endif %}
          {% if item.version is defined and item.version is not empty %}
          <span class="version-chip">{{ item.version }}</span>
          {% endif %}
          {% if item.tag is defined and item.tag is not empty %}
          <span class="tag-chip" data-tag="{{ item.tag }}">{{ item.tag }}</span>
          {% endif %}
        </p>
        <h2 class="release-title">
          <a href="{{ url }}">{{ item.hero_title | default(item.title) }}</a>
        </h2>
        {% if item.deck is defined and item.deck is not empty %}
        <p class="release-desc">{{ item.deck | striptags }}</p>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p class="empty">Nothing shipped yet — the first release you publish starts the timeline.</p>
    {% endif %}
  </section>
</main>

{{ theme.partial('footer') | raw }}
