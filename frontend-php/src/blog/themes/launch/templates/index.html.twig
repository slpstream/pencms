{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
  <article class="page landing">
    <section class="hero">
      <h1 class="hero-headline">{{ hero_title | default(sitename | default('Ship your SaaS faster')) }}</h1>
      <p class="hero-tagline">{{ tagline | default(deck | default('Launch is a dual-duty PenCMS marketing theme designed for modern tech products, product releases, and high-converting landing pages.')) }}</p>

      <figure class="hero-frame">
        <span class="frame-bar" aria-hidden="true"><span class="frame-dot"></span><span class="frame-dot"></span><span class="frame-dot"></span></span>
        {% if hero_image is defined and hero_image is not empty %}
        <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}" decoding="async">
        {% else %}
        <img src="{{ theme.asset('images/defaulthero.jpg') }}" alt="Product screenshot" decoding="async">
        {% endif %}
      </figure>
    </section>

    {% if page_content is defined and page_content is not empty %}
    <div class="prose landing-prose article-content traven-preview">
      {{ page_content | raw }}
    </div>
    {% endif %}

    {% if dossiers is defined and dossiers is not empty %}
    <section class="landing-section recent-posts">
      <h2 class="section-heading">Latest Updates & Articles</h2>
      <ul class="post-list">
        {% for dossier in dossiers %}
          {% set url = theme.isStatic() ? (base_path ~ dossier.slug ~ '/index.html') : ('post.php?slug=' ~ dossier.slug ~ '&section=' ~ (dossier.section | default('blog'))) %}
        <li class="post-card">
          <p class="meta">
            <time datetime="{{ dossier.date }}">{{ dossier.date | date("M d, Y") }}</time>
            {% if dossier.version is defined and dossier.version is not empty %}<span class="version-chip">{{ dossier.version }}</span>{% endif %}
            {% if dossier.tag is defined and dossier.tag is not empty %}<span class="tag-chip" data-tag="{{ dossier.tag }}">{{ dossier.tag }}</span>{% endif %}
          </p>
          <h2><a href="{{ url }}">{{ dossier.hero_title | default(dossier.title) }}</a></h2>
          {% if dossier.deck is defined and dossier.deck is not empty %}
          <p class="summary">{{ dossier.deck | striptags }}</p>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

  </article>
</main>

{{ theme.partial('footer') | raw }}
