{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<div class="terminal-window">
    <div class="terminal-window-bar">
        <span class="terminal-window-dots"><span></span><span></span><span></span></span>
        <span class="terminal-window-title">ls -la /var/log/posts</span>
        <span>sh</span>
    </div>
    <div class="terminal-window-body">

        <section class="boot-hero">
            <pre class="boot-hero-pre"><span class="ok">[ ok ]</span> scanning /var/log/posts
<span class="ok">[ ok ]</span> filter: {% if category is not empty %}{{ category }}{% else %}*{% endif %}
<span class="warn">[ * ]</span> {{ dossiers | default([]) | length }} entries matched</pre>
            <h1 class="boot-hero-title">{{ hero_title | default('archive') }}<span class="boot-hero-caret" aria-hidden="true"></span></h1>
        </section>

        <section class="ls-listing">
            <table class="ls-table">
                <thead>
                    <tr>
                        <th>perms</th>
                        <th>date</th>
                        <th>title</th>
                        <th>size</th>
                    </tr>
                </thead>
                <tbody>
                    {% if dossiers is defined and dossiers is not empty %}
                        {% for dossier in dossiers %}
                            {% set url = theme.isStatic() ? (base_path ~ dossier.slug ~ '/index.html') : ('post.php?slug=' ~ dossier.slug ~ '&section=' ~ (dossier.section | default('blog'))) %}
                            <tr>
                                <td class="ls-perms">drwxr-xr-x</td>
                                <td class="ls-date">{{ dossier.date | default(dossier.dateline | default('--- --- --')) }}</td>
                                <td class="ls-title"><a href="{{ url }}">{{ dossier.hero_title | default(dossier.title | default('untitled')) }}</a></td>
                                <td class="ls-date">{{ dossier.read_time | default('—') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="4" class="tree-row-empty"></td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </section>

    </div>
</div>

{{ theme.partial('footer') | raw }}
