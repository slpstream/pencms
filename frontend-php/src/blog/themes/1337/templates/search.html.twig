{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<div class="terminal-window">
    <div class="terminal-window-bar">
        <span class="terminal-window-dots"><span></span><span></span><span></span></span>
        <span class="terminal-window-title">grep &mdash; {{ hero_title | default('search') }}</span>
        <span>sh</span>
    </div>
    <div class="terminal-window-body">

        <h1 class="post-title">{{ hero_title | default('Search') }}</h1>

        {% if deck is not empty %}
            <div class="post-deck">{{ deck | raw }}</div>
        {% endif %}

        <div class="grep-prompt" aria-hidden="true"></div>

        <div
            id="pencms-search"
            class="pencms-search"
            data-search-index-url="{{ search_index_url | default('') }}"
            data-static="{{ theme.isStatic() ? '1' : '0' }}"
            data-base-path="{{ base_path }}"
            data-web-root="{{ base_path }}"
        >
            <label class="search-label" for="search-input">query string</label>
            <input type="search" id="search-input" class="search-input" name="q" placeholder="grep -i …" autocomplete="off" enterkeyhint="search">
            {% if search_index_json is defined and search_index_json is not null %}
            <script type="application/json" id="search-index-data">{{ search_index_json | raw }}</script>
            {% endif %}
            <div id="search-results" class="search-results" aria-live="polite"></div>
        </div>

    </div>
</div>

<script src="{{ publicAsset('vendor/minisearch/minisearch.min.js') }}"></script>
<script src="{{ publicAsset('vendor/minisearch/search-ui.js') }}"></script>

{{ theme.partial('footer') | raw }}
