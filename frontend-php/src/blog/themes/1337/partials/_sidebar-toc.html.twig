{% if posts is defined and posts is not empty and posts|length > 1 %}
<div class="sidebar-widget toc-widget">
    <h3 class="sidebar-title">cat -n /toc</h3>
    <ol class="toc-list">
        {% for post in posts %}
            {% if post.id != 'index' %}
                {% set label = post.title | default('') %}
                {% if label is empty %}
                    {% if post.id == 'intro' or post.id == 'main' %}
                        {% set label = 'Introduction' %}
                    {% else %}
                        {% set label = post.id | replace({'-': ' ', '_': ' '}) | title %}
                    {% endif %}
                {% endif %}
                <li class="toc-level-1">
                    <a href="#{{ post.id }}">{{ label }}</a>
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</div>
{% endif %}
