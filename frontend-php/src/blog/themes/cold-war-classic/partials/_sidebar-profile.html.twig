{% if author.avatar|default('') is not empty or author.bio|default('') is not empty or author.website|default('') is not empty or author.social|default('') is not empty %}
<div class="dossier-card">
    <div class="profile-body">
        {% if author.avatar is not empty %}
            <div class="dossier-profile-img">
                <img src="{{ author.avatar }}" alt="{{ author.display_name|e }}"
                    class="profile-image">
            </div>
        {% endif %}
        <h3 class="sidebar-heading">{{ author.display_name|e }}</h3>
        {% if author.bio is not empty %}
            <p class="author-bio">{{ author.bio|e }}</p>
        {% endif %}
    </div>
</div>
{% endif %}

