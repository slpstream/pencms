{% set home_url = base_path ~ (theme.isStatic() ? 'index.html' : 'index.php') %}
{% set logo_url = theme.getLogoUrl() %}

<header class="header-textured site-header">
    {% if logo_url %}
        <a href="{{ home_url }}" class="logo-stamp"
            aria-label="{{ sitename | default('Archive') }}">
            <img src="{{ logo_url }}" alt="{{ sitename | default('Archive') }}" class="site-logo">
        </a>
    {% else %}
        <a href="{{ home_url }}" class="logo-stamp"
            aria-label="{{ sitename | default('Archive') }}">
            <span class="site-title">{{ sitename | default('Archive') }}</span>
        </a>
    {% endif %}

    <div class="nav-container">
        <div class="header-tagline-line">
            <span class="site-tagline">
                {{ tagline | default('An awesome blog') }}
            </span>
        </div>
        <div class="header-rule"></div>
        {{ theme.partial('navbar') | raw }}
    </div>
</header>
