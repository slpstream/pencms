<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% set page_heading = hero_title | default(page_title | default(sitename | default('Cold War'))) %}
    {% set site_name = sitename | default('Cold War') %}
    {% set abs_og_image = og_image | default(og_default_image | default('images/defaulthero.jpg')) %}
    {% if theme.isStatic() and slug is defined and slug is not empty %}
        {% set abs_og_image = (site_url | default('') | trim('/', 'right')) ~ '/images/og/' ~ slug ~ '.jpg' %}
    {% elseif not (abs_og_image matches '/^https?:\\/\\//') %}
        {% set abs_og_image = contentAsset(abs_og_image) %}
    {% endif %}

    <title>{{ page_heading }}{% if page_heading != site_name %} | {{ site_name }}{% endif %}</title>
    <meta name="description" content="{{ meta_description | default(tagline | default('A deep dive into the world of Cold War history.')) }}">
    {% if keywords is defined and keywords is not empty %}
    <meta name="keywords" content="{{ keywords }}">
    {% endif %}

    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url | default('') }}">
    <meta property="og:title" content="{{ og_title | default(og_title_fallback | default(page_heading)) }}">
    <meta property="og:description" content="{{ og_description | default(og_description_fallback | default(meta_description | default(''))) }}">
    <meta property="og:image" content="{{ abs_og_image }}">

    <meta name="twitter:card" content="{{ twitter_card | default('summary_large_image') }}">
    <meta name="twitter:title" content="{{ og_title | default(og_title_fallback | default(page_heading)) }}">
    <meta name="twitter:description" content="{{ og_description | default(og_description_fallback | default(meta_description | default(''))) }}">
    <meta name="twitter:image" content="{{ abs_og_image }}">

    <link rel="preload" href="{{ asset('fonts/CourierPrime.ttf') }}" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="{{ asset('fonts/CourierPrime-Bold.ttf') }}" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="{{ asset('fonts/serif.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fonts/serif-italic.woff2') }}" as="font" type="font/woff2" crossorigin>

    {# Shared font registry (Style Settings) — private Main Serif faces stay theme-local #}
    <link rel="stylesheet" href="{{ publicAsset('fonts/fonts.css') }}">

    {{ theme.linkCss('css/skin-cold-war.css') | raw }}
    <link rel="stylesheet" href="{{ publicAsset('vendor/traven/expand-embed.css') }}">
    {{ theme.linkCss('css/styles.css') | raw }}
    <link rel="stylesheet" href="{{ publicAsset('vendor/katex/katex.min.css') }}">
    <script type="module" src="{{ publicAsset('vendor/traven/expand-embed-runtime.js') }}"></script>

    {#
      SVG filter ids must be referenced from a document-scoped stylesheet.
      External CSS resolves url(#id) against the stylesheet URL, so those
      references miss the in-page <filter> elements and the entire filter
      property is dropped (only the pure-CSS yellow vignette survives).
      Keep the <style> in <head>; the <svg> defs must live in <body>
      (SVG in <head> can close head early during HTML parsing).
    #}
    <style id="cold-war-svg-filters">
        .article-hero-img {
            filter: url("#cold-war-tint") contrast(1.1);
        }
        .hero-image-layer {
            filter: saturate(0.33) contrast(1.25) url("#tonemap") url("#sharpen");
        }
        .photo-wrapper {
            filter: url("#cold-war-tint") contrast(1.1);
        }
        .photo-wrapper img {
            filter: url("#sharpen");
        }
        .traven-preview img.traven-image-shortcode {
            filter: url("#cold-war-tint") contrast(1.1);
        }
    </style>

    <link rel="alternate" type="application/rss+xml" title="{{ site_name }} RSS" href="{{ base_path }}feed.xml">
    {% if theme.isStatic() %}
    <link rel="alternate" type="text/markdown" href="index.md">
    {% endif %}
</head>
<body class="site-body">
{#
  Filter defs must be in <body> (not <head>) and must keep the SVG default
  color-interpolation-filters (linearRGB). Forcing sRGB warms the split-tone
  curves into a global yellow/cream cast on whites and highlights.
#}
<svg class="cold-war-filter-definitions" xmlns="http://www.w3.org/2000/svg"
    width="0" height="0" aria-hidden="true" focusable="false"
    style="position:absolute;width:0;height:0;overflow:hidden">
    <defs>
        <!-- Sharpness: Equivalent to PIL 1.2 -->
        <filter id="sharpen">
            <feConvolveMatrix order="3" kernelMatrix="0 -0.15 0 -0.15 1.6 -0.15 0 -0.15 0"/>
        </filter>
        <!-- Highlight Energy: Gamma Tonal Mapping -->
        <filter id="tonemap">
            <feComponentTransfer>
                <feFuncR type="gamma" exponent="0.935"/>
                <feFuncG type="gamma" exponent="0.935"/>
                <feFuncB type="gamma" exponent="0.935"/>
            </feComponentTransfer>
        </filter>
        <!-- Archival Tint: Cold Shadows, Warm Highlights (linearRGB default) -->
        <filter id="cold-war-tint">
            <feColorMatrix type="matrix" values="0.21 0.72 0.07 0 0
                                                 0.21 0.72 0.07 0 0
                                                 0.21 0.72 0.07 0 0
                                                 0 0 0 1 0"/>
            <feComponentTransfer>
                <feFuncR type="table" tableValues="0.0 0.25 0.5 0.75 1.0"/>
                <feFuncG type="table" tableValues="0.0 0.25 0.5 0.75 0.98"/>
                <feFuncB type="table" tableValues="0.04 0.28 0.5 0.72 0.85"/>
            </feComponentTransfer>
        </filter>
    </defs>
</svg>
