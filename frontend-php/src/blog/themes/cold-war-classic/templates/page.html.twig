{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-layout-container page-layout">
    <article class="article-box-standard">
        <header class="article-header-divider">
            <h1 class="article-title">{{ hero_title | default('Page') }}</h1>
            {% if deck is not empty %}
                <div class="article-deck">{{ deck | raw }}</div>
            {% endif %}
        </header>

        {% set page_hero = hero_image | default('') %}
        {% if page_hero is not empty and page_hero != 'images/defaulthero.jpg' %}
            <figure class="article-hero-wrap">
                <img src="{{ contentAsset(page_hero) }}" class="article-hero-img" alt="{{ hero_title | default('Page') }}">
            </figure>
        {% endif %}

        <div class="article-content traven-preview">
            {{ page_content | default('') | raw }}
        </div>

        {{ theme.partial('faqs') | raw }}
    </article>

    <aside class="sidebar-stack">
        {{ theme.partial('sidebar-secondary') | raw }}
        {% if author.avatar|default('') is not empty or author.bio|default('') is not empty or author.website|default('') is not empty or author.social|default('') is not empty %}
            {{ theme.partial('sidebar-profile') | raw }}
        {% endif %}
        {{ theme.partial('sidebar-related') | raw }}
    </aside>
</main>

{{ theme.partial('footer') | raw }}
