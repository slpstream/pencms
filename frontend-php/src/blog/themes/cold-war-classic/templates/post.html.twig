{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set hero_src = hero_image | default('images/defaulthero.jpg') %}
<section class="hero-article">
    <div class="hero-red-line"></div>

    <div class="hero-visual-wrap">
        <div class="hero-image-layer" style="background-image: url('{{ contentAsset(hero_src) }}');"></div>
        <div class="hero-vignette crt-lines"></div>
    </div>

    <div class="hero-content-overlay">
        <div class="jagged-indent"></div>
        <h1 class="hero-title">
            <span class="marker-redacted">{{ hero_title | default('Untitled Dossier') }}</span>
        </h1>
    </div>
</section>

<div class="post-deck-band">
    <div class="article-deck">{{ deck | default('') | raw }}</div>
</div>

<main class="main-layout-container post-layout">
    <div class="feed">
        {% for post in posts %}
            {% set fragment_id = post.id | default('fragment-' ~ loop.index) %}
            {% set post_title = post.title | default('') %}
            {% set post_metadata = post.metadata | default([]) %}
            {% set post_tags = post.tags | default([]) %}
            {% set post_trumpet = post.trumpet | default(trumpet | default('BACKGROUND BRIEFING // NOT FOR PUBLICATION')) %}

            <article class="article-box-standard" id="{{ fragment_id }}">
                <div class="trumpet-header">
                    <span>{{ post_trumpet | raw }}</span>
                </div>
                <div class="paperclip"></div>

                {% if post_metadata is not empty or (post_title is not empty and not is_composite) %}
                    <div class="article-header-divider">
                        {% if post_metadata is not empty %}
                            <div class="metadata-slugs">
                                {% for slug_item in post_metadata %}
                                    <span>{{ slug_item }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if post_title is not empty and not is_composite %}
                            <h2 class="article-title">{{ post_title }}</h2>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="article-content traven-preview">
                    {{ post.content_html | default('') | raw }}
                </div>

                {% if post_tags is not empty %}
                    <div class="tag-list">
                        <span>CONNECTED TO:</span>
                        {% for tag in post_tags %}
                            {% if tag is iterable %}
                                {% set tag_label = tag.label | default('') %}
                                {% set raw_href = tag.href | default('#') %}
                            {% else %}
                                {% set tag_label = tag %}
                                {% set raw_href = '#' %}
                            {% endif %}
                            {% if raw_href != '#' and raw_href is not empty %}
                                {% set tag_href = theme.isStatic()
                                    ? (base_path ~ raw_href ~ '/index.html')
                                    : (base_path ~ 'post.php?slug=' ~ raw_href ~ '&section=' ~ (section | default('blog') | url_encode)) %}
                            {% else %}
                                {% set tag_href = '#' %}
                            {% endif %}
                            {% if tag_label is not empty %}
                                <a href="{{ tag_href }}" class="tag">{{ tag_label }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </article>
        {% else %}
            <article class="article-box-standard">
                <div class="article-content traven-preview">
                    <p>No dossier content is currently available.</p>
                </div>
            </article>
        {% endfor %}

        {{ theme.partial('faqs') | raw }}

        <section class="cold-war-classic-discussion">
            {{ theme.partial('comment-thread') | raw }}
            {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
        </section>
    </div>

    <aside class="sidebar-stack">
        {{ theme.partial('sidebar-secondary') | raw }}
        {% if is_composite %}
            {{ theme.partial('sidebar-toc') | raw }}
        {% endif %}
        {% if author.avatar|default('') is not empty or author.bio|default('') is not empty or author.website|default('') is not empty or author.social|default('') is not empty %}
            {{ theme.partial('sidebar-profile') | raw }}
        {% endif %}
        {{ theme.partial('sidebar-related') | raw }}
    </aside>
</main>

{{ theme.partial('footer') | raw }}
