{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set secondary_items = menu('secondary') %}
<main class="main-layout-container search-layout{% if secondary_items is empty %} search-layout--solo{% endif %}">
    <section class="feed">
        <article class="article-box-standard search-panel">
            <div class="trumpet-header">
                <span>Archive Query // Restricted</span>
            </div>

            <header class="search-page-header">
                <h1 class="article-title">{{ hero_title | default('Search') }}</h1>
                <p class="search-lede">Find posts and pages in the archive.</p>
            </header>

            <div
                id="pencms-search"
                class="pencms-search"
                role="search"
                data-search-index-url="{{ search_index_url | default('') }}"
                data-static="{{ theme.isStatic() ? '1' : '0' }}"
                data-base-path="{{ base_path }}"
                data-web-root="{{ base_path }}"
            >
                <label class="search-label" for="search-input">Query</label>
                <input type="search" id="search-input" class="search-input" name="q" placeholder="Subject, name, or keyword…" autocomplete="off" enterkeyhint="search">
                {% if search_index_json is defined and search_index_json is not null %}
                <script type="application/json" id="search-index-data">{{ search_index_json | raw }}</script>
                {% endif %}
                <div id="search-results" class="search-results" aria-live="polite"></div>
            </div>
        </article>
    </section>

    {% if secondary_items is not empty %}
        <aside class="sidebar-stack">
            {{ theme.partial('sidebar-secondary') | raw }}
        </aside>
    {% endif %}
</main>

<script src="{{ publicAsset('vendor/minisearch/minisearch.min.js') }}"></script>
<script src="{{ publicAsset('vendor/minisearch/search-ui.js') }}"></script>

{{ theme.partial('footer') | raw }}
