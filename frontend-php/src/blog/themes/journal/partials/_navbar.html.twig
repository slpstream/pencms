<button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle navigation menu">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hamburger-icon">
        <line x1="4" y1="7" x2="20" y2="7"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="17" x2="20" y2="17"/>
    </svg>
</button>

<nav class="nav-menu" id="nav-menu" aria-label="Main navigation">
    {% set nav_items = menu('primary') %}
    {% for item in nav_items %}
        <div class="nav-item{% if item.children is not empty %} has-children{% endif %}">
            {% if item.target_type == 'label' %}
                <span class="nav-label{% if item.children is not empty %} nav-trigger{% endif %}">
                    {{ item.label }}
                    {% if item.children is not empty %}
                        <svg class="dropdown-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    {% endif %}
                </span>
            {% else %}
                <a href="{{ item.url }}" class="nav-link{% if item.children is not empty %} nav-trigger{% endif %}" {% if item.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>
                    {{ item.label }}
                    {% if item.children is not empty %}
                        <svg class="dropdown-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    {% endif %}
                </a>
            {% endif %}
            {% if item.children is not empty %}
                <div class="dropdown-menu" role="menu">
                    {% for child in item.children %}
                        {% if child.target_type == 'label' %}
                            <span class="nav-label">{{ child.label }}</span>
                        {% else %}
                            <a href="{{ child.url }}" class="dropdown-link" role="menuitem" {% if child.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endfor %}
</nav>

<button class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle dark/light theme" title="Toggle theme">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sun-icon">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
    </svg>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="moon-icon">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
    </svg>
</button>

