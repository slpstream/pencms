{{ theme.partial('head', { is_content: false }) | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
    <section class="list">
        <header class="page-header">
            <h1>{% if category is defined and category is not empty %}Category: {{ category | title }}{% elseif tag is defined and tag is not empty %}Tag: #{{ tag | title }}{% else %}{{ (page_title | default('Archive')) | title }}{% endif %}</h1>
        </header>

        {% set post_list = dossiers is not empty ? dossiers : (posts is not empty ? posts : []) %}
        {% if post_list is not empty %}
            <ol class="post-list" reversed>
                {% for dossier in post_list %}
                    {{ theme.partial('post_card', { dossier: dossier, loop: loop }) | raw }}
                {% endfor %}
            </ol>
        {% else %}
            <p class="empty">No posts found in this archive.</p>
        {% endif %}

        {% if pagination is defined and pagination.total_pages > 1 %}
            <nav class="pagination" aria-label="Pages">
                {% if pagination.current_page > 1 %}
                    <a href="{{ base_path }}?page={{ pagination.current_page - 1 }}">← Newer</a>
                {% endif %}
                <span>Page {{ pagination.current_page }} of {{ pagination.total_pages }}</span>
                {% if pagination.current_page < pagination.total_pages %}
                    <a href="{{ base_path }}?page={{ pagination.current_page + 1 }}">Older →</a>
                {% endif %}
            </nav>
        {% endif %}
    </section>
</main>

{{ theme.partial('footer') | raw }}
