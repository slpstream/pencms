<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">

    {# Prevent theme flash on load #}
    <script>
        (function() {
            let scheme = null;
            try {
                scheme = localStorage.getItem('color-scheme') || localStorage.getItem('theme');
            } catch (e) {}
            if (!scheme) {
                try {
                    const match = document.cookie.match(/(^|;)\s*(?:color-scheme|theme)\s*=\s*([^;]+)/);
                    scheme = match ? match[2] : null;
                } catch (e) {}
            }
            if (scheme === 'dark' || (!scheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else if (scheme === 'light') {
                document.documentElement.classList.remove('cm-wysiwym-dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>


    {# SEO metadata #}
    <title>{% if hero_title is defined and hero_title is not empty and sitename is defined and sitename is not empty and hero_title != sitename %}{{ hero_title }} | {{ sitename }}{% else %}{{ (hero_title is defined and hero_title is not empty) ? hero_title : (sitename is defined ? sitename : '') }}{% endif %}</title>
    <meta name="description" content="{{ (meta_description is defined and meta_description is not empty) ? meta_description : ((tagline is defined and tagline is not empty) ? tagline : 'Keys real-estate agency theme for PenCMS.') }}">
    {% if keywords is defined and keywords is not empty %}
    <meta name="keywords" content="{{ keywords }}">
    {% endif %}

    {# Open Graph / Twitter #}
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url is defined ? canonical_url : '' }}">
    <meta property="og:title" content="{{ (og_title is defined and og_title is not empty) ? og_title : ((og_title_fallback is defined and og_title_fallback is not empty) ? og_title_fallback : ((page_title is defined and page_title is not empty) ? page_title : (sitename is defined ? sitename : ''))) }}">
    <meta property="og:description" content="{{ (og_description is defined and og_description is not empty) ? og_description : ((og_description_fallback is defined and og_description_fallback is not empty) ? og_description_fallback : ((meta_description is defined) ? meta_description : '')) }}">
    
    {% set abs_og_image = (og_image is defined and og_image is not empty) ? og_image : ((og_default_image is defined and og_default_image is not empty) ? og_default_image : 'images/defaulthero.jpg') %}
    {% if theme.isStatic() and (slug is defined and slug is not empty) %}
        {% set abs_og_image = (site_url | trim('/', 'right')) ~ '/images/og/' ~ slug ~ '.jpg' %}
    {% elseif not (abs_og_image matches '/^https?:\\/\\//') %}
        {% set abs_og_image = contentAsset(abs_og_image) %}
    {% endif %}
    <meta property="og:image" content="{{ abs_og_image }}">
    <meta name="twitter:card" content="{{ twitter_card is defined ? twitter_card : 'summary_large_image' }}">
    <meta name="twitter:title" content="{{ (og_title is defined and og_title is not empty) ? og_title : ((og_title_fallback is defined and og_title_fallback is not empty) ? og_title_fallback : ((page_title is defined and page_title is not empty) ? page_title : (sitename is defined ? sitename : ''))) }}">
    <meta name="twitter:description" content="{{ (og_description is defined and og_description is not empty) ? og_description : ((og_description_fallback is defined and og_description_fallback is not empty) ? og_description_fallback : ((meta_description is defined) ? meta_description : '')) }}">
    <meta name="twitter:image" content="{{ abs_og_image }}">

    {# Shared font registry (Style Settings + identity faces) #}
    <link rel="stylesheet" href="{{ publicAsset('fonts/fonts.css') }}">

    {{ theme.linkCss('css/skin-keys.css') | raw }}
    {{ theme.linkCss('css/styles.css') | raw }}

    <link rel="stylesheet" href="{{ publicAsset('vendor/katex/katex.min.css') }}">
    <link rel="stylesheet" href="{{ publicAsset('vendor/traven/expand-embed.css') }}">
    <script type="module" src="{{ publicAsset('vendor/traven/expand-embed-runtime.js') }}"></script>

    <link rel="alternate" type="application/rss+xml" title="{{ (sitename is defined and sitename is not empty) ? sitename : 'RSS' }}" href="{{ base_path }}feed.xml">
    {% if theme.isStatic() %}
    <link rel="alternate" type="text/markdown" href="index.md">
    {% endif %}
</head>
<body class="traven-preview {% if category is defined and category is not empty %}theme-{{ category }}{% endif %}">
<a class="skip-link" href="#main">Skip to content</a>
