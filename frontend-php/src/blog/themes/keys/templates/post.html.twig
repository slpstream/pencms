{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set post_badge = (section is defined and section is not empty) ? section : ((category is defined and category is not empty) ? category : ((status is defined and status is not empty) ? status : '')) %}
<main id="main" class="main-container">
    <article class="listing-post" data-status="{{ (status is defined and status is not empty) ? status : post_badge }}">
        <header class="keys-post-header">
            <div class="listing-topline">
                {% if price is defined and price is not empty %}
                    <strong class="listing-price">{{ price }}</strong>
                {% endif %}
                {% if post_badge is not empty %}
                    <span class="status-flag">{{ post_badge }}</span>
                {% endif %}
                {% if trumpet is defined and trumpet is not empty %}
                    <span class="post-detail-trumpet">{{ trumpet }}</span>
                {% endif %}
            </div>
            
            <h1 class="hero-title">{{ (hero_title is defined and hero_title is not empty) ? hero_title : (title is defined ? title : 'Untitled Property') }}</h1>
            
            {% if address is defined and address is not empty %}
                <p class="listing-address">{{ address }}</p>
            {% endif %}

            {% if deck is defined and deck is not empty %}
                <div class="post-deck">{{ deck | raw }}</div>
            {% endif %}

            {% if (beds is defined and beds is not empty) or (baths is defined and baths is not empty) or (area is defined and area is not empty) or (date is defined and date is not empty) %}
                <p class="spec-row spec-strip">
                    {% if beds is defined and beds is not empty %}<span class="spec">{{ beds }} bd</span>{% endif %}
                    {% if baths is defined and baths is not empty %}<span class="spec">{{ baths }} ba</span>{% endif %}
                    {% if area is defined and area is not empty %}<span class="spec">{{ area }}</span>{% endif %}
                    {% if date is defined and date is not empty %}
                        <span class="spec spec-listed"><time datetime="{{ date }}">{{ date | date("F d, Y") }}</time></span>
                    {% endif %}
                </p>
            {% endif %}
        </header>

        {% set hero_img = (hero_image is defined and hero_image is not empty) ? hero_image : ((cover is defined and cover is not empty) ? cover : ((image is defined and image is not empty) ? image : '')) %}
        {% if hero_img is not empty %}
            <figure class="gallery-single">
                <img src="{{ contentAsset(hero_img) }}" alt="{{ (hero_title is defined and hero_title is not empty) ? hero_title : (title is defined ? title : '') }}" decoding="async" style="aspect-ratio: 16 / 9; object-fit: cover;">
                {% if hero_image_caption is defined and hero_image_caption is not empty %}
                    <span class="caption">{{ hero_image_caption }}</span>
                {% endif %}
            </figure>
        {% endif %}

        <div class="article-content traven-preview">
            {% if posts is defined and posts is not empty %}
                {% for p in posts %}
                    {% if p.title is defined and p.title is not empty and posts|length > 1 %}
                        <h2>{{ p.title }}</h2>
                    {% endif %}
                    {% if p.content_html is defined %}
                        {{ p.content_html | raw }}
                    {% endif %}
                {% endfor %}
            {% elseif page_content is defined and page_content is not empty %}
                {{ page_content | raw }}
            {% elseif content is defined and content is not empty %}
                {{ content | raw }}
            {% endif %}
        </div>

        {{ theme.partial('faqs') | raw }}

        <section class="keys-discussion">
            {{ theme.partial('comment-thread') | raw }}
            {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
        </section>
    </article>
</main>

{{ theme.partial('footer') | raw }}
