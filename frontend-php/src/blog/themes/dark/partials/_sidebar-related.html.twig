{% if related_dossiers is not empty %}
<div class="sidebar-widget sidebar-related-widget">
    <h3 class="sidebar-title">{{ strings.relatedPosts }}</h3>
    <ul class="sidebar-list" style="padding-left: 0 !important; margin-left: 0 !important;">
        {% for post in related_dossiers %}
            {% set url = contentUrl(post) %}
            {% set has_thumb = post.hero_image is not empty and post.hero_image != 'images/defaulthero.png' and post.hero_image != 'images/defaulthero.jpg' %}
            <li class="sidebar-list-item" style="padding-left: 0 !important; margin-left: 0 !important;">
                <a href="{{ url }}" class="sidebar-list-link" style="text-decoration: none;">
                    {% if has_thumb %}
                        <img src="{{ contentAsset(post.hero_image) }}" alt="" class="sidebar-thumb" loading="lazy">
                    {% endif %}
                    <span class="sidebar-list-title">{{ post.hero_title | default(post.title) }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
</div>
{% endif %}
