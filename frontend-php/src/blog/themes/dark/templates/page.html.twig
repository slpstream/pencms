{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-container page-container">
    <article class="post-detail-header">
        <h1 class="post-detail-title page-title">{{ hero_title }}</h1>
        
        {% if hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
            <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}" class="post-detail-hero-image page-hero">
        {% endif %}
        
        <div class="article-content traven-preview">
            {{ page_content | raw }}
        </div>

        {{ theme.partial('faqs') | raw }}
    </article>
</main>

{{ theme.partial('footer') | raw }}
