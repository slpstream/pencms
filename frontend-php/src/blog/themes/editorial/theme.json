{
  "type": "native",
  "name": "Editorial",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Editorial theme with a no-distraction, minimalist design that focuses on prose.",
  "editor_skin": "editorial",
  "color_mode": "light",
  "editor_skin_base": [
    "starter"
  ],
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--traven-bg",
            "default": "#fcfbf9"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--traven-text",
            "default": "#1e293b"
          },
          {
            "id": "headings",
            "label": "Headings",
            "type": "color",
            "var": "--traven-h-color",
            "default": "#0f172a"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--traven-caret",
            "default": "#0f172a"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--traven-muted",
            "default": "#64748b"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--traven-border",
            "default": "#cbd5e1"
          },
          {
            "id": "border-light",
            "label": "Light Borders",
            "type": "color",
            "var": "--traven-border-light",
            "default": "#e2e8f0"
          },
          {
            "id": "code-bg",
            "label": "Code Background",
            "type": "color",
            "var": "--traven-code-bg",
            "default": "#f8fafc"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--traven-font-display",
            "default": "\"Macondo\", Georgia, serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "\"Macondo\", Georgia, serif",
                "label": "Macondo"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--traven-font-body",
            "default": "\"Goudy Bookletter 1911\", Georgia, serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "\"Goudy Bookletter 1911\", Georgia, serif",
                "label": "Goudy Bookletter 1911"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--traven-font-mono",
            "default": "\"Victor Mono\", Courier, monospace",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "\"Victor Mono\", Courier, monospace",
                "label": "Victor Mono"
              },
              {
                "value": "'Fira Code', monospace",
                "label": "Fira Code"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#1A1A1A",
    "og_vignette_color": "#8B7355",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#000000",
    "og_font": "Macondo-Regular",
    "og_fonts": {
      "Macondo-Regular": "assets/fonts/Macondo-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": false,
    "og_watermark": "assets/images/watermark.png",
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
