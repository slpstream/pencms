{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<section class="hero-banner">
    <h1 class="hero-title-text">{{ hero_title | default(strings.search) }}</h1>
    <p class="hero-tagline-text">{{ strings.findPostsAndPages }}</p>
</section>

{% set secondary_items = menu('secondary') %}
<main class="main-container{% if secondary_items is empty %} main-container-narrow{% endif %}">
    <div class="{% if secondary_items is not empty %}layout-grid layout-grid-with-nav{% else %}feed-posts-wrap{% endif %}">
        {% if secondary_items is not empty %}
            <aside class="sidebar-column sidebar-column-nav">
                {{ theme.partial('sidebar-secondary') | raw }}
            </aside>
        {% endif %}

        <div class="feed-posts">
            <div
                id="pencms-search"
                class="pencms-search"
                data-search-index-url="{{ search_index_url | default('') }}"
                data-static="{{ theme.isStatic() ? '1' : '0' }}"
                data-base-path="{{ base_path }}"
                data-web-root="{{ base_path }}"
                data-loading-text="{{ strings.loadingSearchIndex }}"
                data-no-results-text="{{ strings.noSearchResults }}"
                data-hint-text="{{ strings.searchHint }}"
                data-unavailable-text="{{ strings.searchUnavailable }}"
                data-page-text="{{ strings.page }}"
                data-post-text="{{ strings.post }}"
            >
                <label class="search-label" for="search-input">{{ strings.search }}</label>
                <input
                    type="search"
                    id="search-input"
                    class="search-input"
                    name="q"
                    placeholder="{{ strings.searchPlaceholder }}"
                    autocomplete="off"
                    enterkeyhint="search"
                >

                {% if search_index_json is defined and search_index_json is not null %}
                <script type="application/json" id="search-index-data">{{ search_index_json | raw }}</script>
                {% endif %}

                <div id="search-results" class="search-results" aria-live="polite"></div>
            </div>
        </div>
    </div>
</main>

<script src="{{ publicAsset('vendor/minisearch/minisearch.min.js') }}"></script>
<script src="{{ publicAsset('vendor/minisearch/search-ui.js') }}"></script>

{{ theme.partial('footer') | raw }}
