{% set secondary_items = menu('secondary') %}
{% if secondary_items is not empty %}
<aside class="secondary-nav-widget" aria-label="Secondary navigation">
    <h3 class="secondary-nav-title">Quick links</h3>
    <ul class="secondary-nav-list">
        {% for item in secondary_items %}
            <li class="secondary-nav-item{% if item.children is not empty %} has-children{% endif %}">
                {% if item.target_type == 'label' %}
                    <span class="secondary-nav-label">{{ item.label }}</span>
                {% else %}
                    <a href="{{ item.url }}" class="secondary-nav-link" {% if item.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
                {% endif %}
                {% if item.children is not empty %}
                    <ul class="secondary-nav-children">
                        {% for child in item.children %}
                            <li>
                                {% if child.target_type == 'label' %}
                                    <span class="secondary-nav-label">{{ child.label }}</span>
                                {% else %}
                                    <a href="{{ child.url }}" class="secondary-nav-link" {% if child.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</aside>
{% endif %}
{{ theme.partial('social-links') | raw }}
