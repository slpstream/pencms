{
  "type": "native",
  "name": "Colorful",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Vibrant & Colorful theme — Atkinson Hyperlegible Next, Fira Code, and a bright accessible accent system on clean white.",
  "editor_skin": "colorful",
  "color_mode": "light",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--traven-bg",
            "default": "#ffffff"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--traven-text",
            "default": "#1e293b"
          },
          {
            "id": "headings",
            "label": "Headings",
            "type": "color",
            "var": "--traven-h-color",
            "default": "#92400e"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--traven-caret",
            "default": "#cc4a0a"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--traven-muted",
            "default": "#64748b"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--traven-border",
            "default": "#cbd5e1"
          },
          {
            "id": "accent-indigo",
            "label": "Indigo Accent",
            "type": "color",
            "var": "--traven-accent-indigo",
            "default": "#6366f1"
          },
          {
            "id": "accent-blue",
            "label": "Blue Accent",
            "type": "color",
            "var": "--traven-accent-blue",
            "default": "#3b82f6"
          },
          {
            "id": "accent-rose",
            "label": "Rose Accent",
            "type": "color",
            "var": "--traven-accent-rose",
            "default": "#e11d48"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--traven-font-display",
            "default": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--traven-font-body",
            "default": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--traven-font-mono",
            "default": "'Fira Code', monospace",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Fira Code', monospace",
                "label": "Fira Code"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#cc4a0a",
    "og_vignette_color": "#6366f1",
    "og_text_color": "#FFFFFF",
    "og_bar_color": "#1e293b",
    "og_font": "AtkinsonHyperlegibleNext-Bold",
    "og_fonts": {
      "AtkinsonHyperlegibleNext-Bold": "assets/fonts/AtkinsonHyperlegibleNext-Bold.ttf",
      "AtkinsonHyperlegibleNext-Regular": "assets/fonts/AtkinsonHyperlegibleNext-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": "assets/images/watermark.png",
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
