<header class="site-head">
    <a href="{{ base_path ~ (theme.isStatic() ? 'index.html' : 'index.php') }}" class="site-title">
        {% set logo = theme.getLogoUrl() %}
        {% if logo is not empty %}
            <img src="{{ logo }}" alt="" class="site-logo" style="height: 24px; vertical-align: middle; margin-right: 8px;">
        {% endif %}
        {{ sitename | default('Studio') }}
    </a>
    {{ theme.partial('navbar') | raw }}
</header>
