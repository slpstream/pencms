<footer class="colophon">
    <p>{{ sitename | default('Studio') }}{% if tagline is not empty %} — {{ tagline }}{% endif %}</p>

    {% set footer_items = menu('footer') %}
    {% if footer_items is not empty %}
        <nav class="colophon-nav" aria-label="Footer Navigation">
            <ul class="colophon-menu">
                {% for item in footer_items %}
                    {% set is_item_active = item.is_active|default(false) %}
                    <li class="footer-item{% if item.children is not empty %} has-children{% endif %}{% if is_item_active %} active{% endif %}">
                        {% if item.target_type == 'label' %}
                            <span class="wall-label">{{ item.label }}</span>
                        {% else %}
                            <a href="{{ item.url }}" {% if item.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
                        {% endif %}
                        {% if item.children is not empty %}
                            <ul class="sub-menu footer-sub-menu">
                                {% for child in item.children %}
                                    {% set is_child_active = child.is_active|default(false) %}
                                    <li class="{% if is_child_active %}active{% endif %}">
                                        {% if child.target_type == 'label' %}
                                            <span class="wall-label">{{ child.label }}</span>
                                        {% else %}
                                            <a href="{{ child.url }}" {% if child.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}

    <p class="colophon-note" style="margin-top: 1.5rem; opacity: 0.7;">&copy; {{ "now"|date("Y") }} {{ sitename | default('Studio') }} &bull; Powered by <a href="https://pencms.org/" style="color: inherit;">PenCMS</a></p>
</footer>

<script src="{{ theme.asset('js/theme.js') }}"></script>

{# KaTeX Auto-Render Math Scripts #}
<script src="{{ publicAsset('vendor/katex/katex.min.js') }}"></script>
<script src="{{ publicAsset('vendor/katex/contrib/auto-render.min.js') }}"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (window.renderMathInElement) {
            renderMathInElement(document.body, {
                delimiters: [
                    {left: '$$', right: '$$', display: true},
                    {left: '$', right: '$', display: false},
                    {left: '\\(', right: '\\)', display: false},
                    {left: '\\[', right: '\\]', display: true}
                ],
                throwOnError: false
            });
        }
    });
</script>

{# Mermaid Loader & Renderer #}
<script src="{{ publicAsset('vendor/mermaid/mermaid.min.js') }}"></script>
<script>
    document.querySelectorAll('pre code.language-mermaid').forEach(function(codeBlock) {
        const pre = codeBlock.parentNode;
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = codeBlock.textContent;
        pre.replaceWith(div);
    });

    mermaid.initialize({
        startOnLoad: true,
        theme: document.documentElement.classList.contains('cm-wysiwym-dark') ? 'dark' : 'default'
    });
</script>
</body>
</html>
