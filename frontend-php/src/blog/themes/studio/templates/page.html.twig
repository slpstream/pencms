{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
    <article class="page">
        {% if hero_image is defined and hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
            <figure class="project-cover">
                <img src="{{ contentAsset(hero_image) }}" alt="" decoding="async" style="aspect-ratio: 21 / 9; object-fit: cover;">
            </figure>
        {% endif %}

        <header class="page-head column">
            <h1>{{ hero_title | default(title | default(name | default('Untitled Page'))) }}</h1>
            {% if deck is defined and deck is not empty %}
                <p class="lede">{{ deck | striptags }}</p>
            {% endif %}
        </header>

        <div class="prose article-content traven-preview column">
            {% if page_content is defined and page_content is not empty %}
                {{ page_content | raw }}
            {% elseif posts is defined and posts is not empty %}
                {% for post_item in posts %}
                    {{ post_item.content_html | raw }}
                {% endfor %}
            {% else %}
                {{ content_html | default(content | default('')) | raw }}
            {% endif %}
        </div>

        {{ theme.partial('faqs') | raw }}
    </article>
</main>

{{ theme.partial('footer') | raw }}
