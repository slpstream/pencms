{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main class="main-wrapper">
    <section class="hero-section">
        {% if tagline is defined and tagline is not empty %}
            <span class="hero-tag">{{ tagline }}</span>
        {% endif %}
        {% if hero_title is defined and hero_title is not empty %}
            <h1 class="hero-heading">{{ hero_title }}</h1>
        {% endif %}
        {% if deck is defined and deck is not empty %}
            <p class="hero-deck-text">
                {{ deck | raw }}
            </p>
        {% endif %}
    </section>

    <div class="magazine-grid">
        {% for item in dossiers | default([]) %}
            {% set slug = item.slug | default('') %}
            {% set section = item.section | default('blog') %}
            {% set url = theme.isStatic() ? ((base_path | default('')) ~ slug ~ '/index.html') : ((base_path | default('')) ~ 'post.php?slug=' ~ slug ~ '&section=' ~ section) %}
            
            {% set is_lead = loop.first %}
            <a href="{{ url }}" class="magazine-card {% if is_lead %}magazine-card-lead{% endif %}">
                <div class="card-media">
                    {% set card_img = item.hero_image | default(theme.asset('images/defaulthero.jpg')) %}
                    <img src="{{ contentAsset(card_img) }}" alt="{{ item.hero_title | default(item.title) }}" />
                </div>
                <div class="card-body">
                    <div class="card-tagline">
                        {% if item.category is defined and item.category is not empty %}
                            <span class="card-badge">{{ item.category }}</span>
                        {% else %}
                            <span class="card-badge">Article</span>
                        {% endif %}

                        {% if item.trumpet is defined and item.trumpet is not empty %}
                            <span class="card-badge-separator">&bull;</span>
                            <span class="card-trumpet">{{ item.trumpet }}</span>
                        {% endif %}
                    </div>

                    <h2 class="card-title">{{ item.hero_title | default(item.title) }}</h2>
                    
                    {% if item.deck is not empty and item.deck != '...' %}
                        {% if is_lead %}
                            <p class="card-description">{{ item.deck | striptags }}</p>
                        {% else %}
                            <p class="card-description">{{ item.deck | striptags | slice(0, 140) }}...</p>
                        {% endif %}
                    {% endif %}
                </div>
            </a>
        {% else %}
            <p>No articles published yet.</p>
        {% endfor %}
    </div>
</main>

{{ theme.partial('secondary-footer') | raw }}
{{ theme.partial('footer') | raw }}
