{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

{% set has_hero = hero_image is not empty and hero_image != 'images/defaulthero.jpg' %}
{% set byline = author is iterable ? (author.name | default('')) : author %}
{% set zone = category | default(section | default('')) %}

<main id="main" class="cc-desk page-post">
    <div class="cc-desk-grid">
        <aside class="cc-tabs" aria-label="File tabs">
            {{ theme.partial('sidebar-secondary') | raw }}
            {{ theme.partial('sidebar-toc') | raw }}
        </aside>

        <article class="cc-folder">
            <div class="cc-paperclip cc-paperclip--folder" aria-hidden="true"></div>
            <div class="cc-punchholes cc-punchholes--folder" aria-hidden="true"><span></span><span></span></div>

            <header class="cc-folder-head">
                {% if zone is not empty or trumpet is not empty %}
                <p class="cc-folder-kicker">
                    {% if zone is not empty %}<span class="cc-stamp cc-stamp-small">{{ zone | upper }}</span>{% endif %}
                    {% if trumpet is not empty and trumpet != zone %}{{ trumpet }}{% endif %}
                </p>
                {% endif %}

                <h1 class="cc-post-title post-detail-title">{{ hero_title | default(title | default('Untitled')) | upper }}</h1>

                {% if deck is not empty %}
                    <div class="cc-post-deck post-detail-deck">{{ deck | raw }}</div>
                {% endif %}

                {% if byline is not empty or dateline is not empty or date is not empty %}
                <table class="cc-form">
                    <tbody>
                        {% if byline is not empty %}<tr><th>Reporting</th><td>{{ byline }}</td></tr>{% endif %}
                        {% if dateline is not empty %}
                            <tr><th>Dateline</th><td>{{ dateline }}</td></tr>
                        {% elseif date is not empty %}
                            <tr><th>Date</th><td>{{ date | date("d F Y") }}</td></tr>
                        {% endif %}
                    </tbody>
                </table>
                {% endif %}

            </header>

            <div class="cc-prose">
                {% if has_hero %}
                    <figure class="cc-hero-polaroid">
                        <img src="{{ contentAsset(hero_image) }}" alt="{{ hero_title }}">
                        <figcaption class="cc-hand">{{ name | default(slug | default('')) }}</figcaption>
                    </figure>
                {% endif %}
                {% for post in posts %}
                    <section class="cc-fragment" id="{{ post.id }}">
                        {% if post.title is not empty and posts|length > 1 %}
                            <h2 class="cc-fragment-title">{{ post.title }}</h2>
                        {% endif %}
                        <div class="article-content traven-preview">
                            {{ post.content_html | raw }}
                        </div>
                    </section>
                {% endfor %}

                {{ theme.partial('faqs') | raw }}

                <section class="coldcase-discussion">
                    {{ theme.partial('comment-thread') | raw }}
                    {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
                </section>
            </div>
        </article>
    </div>

    {{ theme.partial('sidebar-related') | raw }}
</main>

{{ theme.partial('footer') | raw }}
