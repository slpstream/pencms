{% if posts is not empty and posts|length > 1 %}
<nav class="cc-hang cc-hang--toc" aria-label="On this page">
    <p class="cc-hang-kicker">Exhibits</p>
    <ol class="cc-hang-list">
        {% for post in posts %}
            {% if post.id != 'index' %}
                {% set label = post.title | default('') %}
                {% if label is empty %}
                    {% if post.id == 'intro' or post.id == 'main' %}
                        {% set label = 'Introduction' %}
                    {% else %}
                        {% set label = post.id | replace({'-': ' ', '_': ' '}) | title %}
                    {% endif %}
                {% endif %}
                <li class="cc-hang-item">
                    <a href="#{{ post.id }}">{{ '%02d'|format(loop.index) }} · {{ label }}</a>
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</nav>
{% endif %}
