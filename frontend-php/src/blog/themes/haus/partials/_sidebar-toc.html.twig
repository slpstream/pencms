{% if posts is not empty and posts|length > 1 %}
<nav class="rule-toc" aria-label="On this page">
    <p class="mod-label">Contents</p>
    <ol class="rule-toc-list">
        {% for post in posts %}
            {% if post.id != 'index' %}
                {% set label = post.title | default('') %}
                {% if label is empty %}
                    {% if post.id == 'intro' or post.id == 'main' %}
                        {% set label = 'Introduction' %}
                    {% else %}
                        {% set label = post.id | replace({'-': ' ', '_': ' '}) | title %}
                    {% endif %}
                {% endif %}
                <li>
                    <span class="rule-toc-num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                    <a href="#{{ post.id }}">{{ label }}</a>
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</nav>
{% endif %}
