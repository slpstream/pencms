{
  "type": "native",
  "name": "Ink",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "Literary theme featuring Newsreader serif typography, light and dark mode, and media gradients.",
  "editor_skin": "ink",
  "color_mode": "both",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": true,
    "sidebars": true,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "dark_scope": {
      "selector": "html.cm-wysiwym-dark, html[data-theme=\"dark\"]"
    },
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Page Background",
            "type": "color",
            "var": "--color-bg-page",
            "default": "#faf9f6",
            "dark_default": "#220a0e"
          },
          {
            "id": "panel",
            "label": "Chrome / Panel",
            "type": "color",
            "var": "--color-bg-card",
            "default": "#ffffff",
            "dark_default": "#180709"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--color-text-body",
            "default": "#000000",
            "dark_default": "#ebdcdb"
          },
          {
            "id": "text-main",
            "label": "Headings / Nav Text",
            "type": "color",
            "var": "--color-text-main",
            "default": "#000000",
            "dark_default": "#f5f0f1"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--color-text-muted",
            "default": "#6b7280",
            "dark_default": "#b89b9e"
          },
          {
            "id": "deck",
            "label": "Deck Text",
            "type": "color",
            "var": "--color-text-deck",
            "default": "#374151",
            "dark_default": "#dfc8ca"
          },
          {
            "id": "accent",
            "label": "Links / Accent",
            "type": "color",
            "var": "--color-link",
            "default": "#6d28d9",
            "dark_default": "#f0b8bc"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--color-border",
            "default": "#e5e7eb",
            "dark_default": "#381217"
          },
          {
            "id": "code-bg",
            "label": "Code Background",
            "type": "color",
            "var": "--color-code-bg",
            "default": "#e5e7eb",
            "dark_default": "#381419"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--font-display",
            "default": "'Newsreader', Georgia, serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Newsreader', Georgia, serif", "label": "Newsreader" },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--font-body",
            "default": "'Newsreader', Georgia, serif",
            "options": [
              { "value": "", "label": "Theme default" },
              { "value": "'Newsreader', Georgia, serif", "label": "Newsreader" },
              { "value": "Georgia, 'Times New Roman', serif", "label": "Georgia" }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--font-mono",
            "default": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
            "options": [
              { "value": "", "label": "Theme default" },
              {
                "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#220a0e",
    "og_vignette_color": "#6b7280",
    "og_text_color": "#000000",
    "og_bar_color": "#faf9f6",
    "og_font": "Newsreader-Bold",
    "og_fonts": {
      "Newsreader-Bold": "assets/fonts/Newsreader-Bold.ttf",
      "Newsreader-Regular": "assets/fonts/Newsreader-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": null,
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
