{% set secondary_items = menu('secondary') %}
{% if secondary_items is not empty %}
<nav class="secondary-nav-strip" aria-label="Secondary Navigation">
  <div class="secondary-nav-inner">
    <ul class="secondary-nav-links">
      {% for item in secondary_items %}
        <li class="nav-item{% if item.children is not empty %} has-children{% endif %}">
          {% if item.target_type == 'label' %}
            <span class="nav-label">{{ item.label }}</span>
          {% else %}
            <a href="{{ item.url }}" class="nav-link" {% if item.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
          {% endif %}
          {% if item.children is not empty %}
            <ul class="nav-dropdown" role="menu">
              {% for child in item.children %}
                <li>
                  {% if child.target_type == 'label' %}
                    <span class="nav-label">{{ child.label }}</span>
                  {% else %}
                    <a href="{{ child.url }}" role="menuitem" {% if child.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}>{{ child.label }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</nav>
{% endif %}
