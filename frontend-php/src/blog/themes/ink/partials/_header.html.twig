<nav class="site-nav">
  <div class="site-nav-inner">
    {% if body_class|default('') != 'page-front' %}
      <a class="site-nav-brand" href="{{ base_path }}">
        {% set site_logo = theme.getLogoUrl() %}
        {% if site_logo is not empty %}
          <img src="{{ site_logo }}" alt="{{ sitename | default('Site Name') }}" class="site-logo">
        {% endif %}
        <span>{{ sitename | default('Site Name') }}</span>
      </a>
    {% endif %}

    {{ theme.partial('navbar') | raw }}

    <div class="nav-actions">
      <!-- Dark / Light Mode Toggle Button -->
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme" title="Toggle theme">
        <!-- Sun Icon (visible in dark mode) -->
        <svg class="sun-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <!-- Moon Icon (visible in light mode) -->
        <svg class="moon-icon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>

      <!-- Mobile Hamburger Menu Toggle Button -->
      <button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle mobile menu" aria-expanded="false">
        <svg class="menu-icon" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg class="close-icon" viewBox="0 0 24 24" style="display:none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>
</nav>
