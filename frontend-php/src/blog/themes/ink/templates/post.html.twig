{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<!-- Reading Progress Bar -->
<div aria-hidden="true" class="reading-progress-container">
  <div class="reading-progress-bar" style="width: 0%;"></div>
</div>

<main class="main-content">
  <!-- Post Header with Hero Image & Gradient -->
  <header class="post-header-outer">
    {% set current_hero = hero_image | default(null) %}
    {% if current_hero is not empty %}
      <div class="hero-image-wrapper">
        <div class="hero-image-container">
          <div class="hero-image-gradient"></div>
          <img alt="" loading="lazy" decoding="async" class="hero-image" src="{{ theme.contentAsset(current_hero) }}">
        </div>
      </div>
    {% endif %}

    <div class="post-header-inner">
      <div class="post-meta">
        {% if date is not empty %}
          <p class="post-date">{{ date | date("F d, Y") }}</p>
        {% endif %}
        <h1 class="post-title">{{ hero_title | default(page_title | default('Untitled')) }}</h1>
        {% if deck is not empty %}
          <p class="post-deck">{{ deck | striptags }}</p>
        {% endif %}
      </div>
    </div>
  </header>

  <!-- Post Body Container -->
  <div class="post-body-container">
    <div class="post-body">
      {% for post in posts %}
        <article id="{{ post.id }}">
          {% if post.title is not empty and posts|length > 1 %}
            <h2>{{ post.title }}</h2>
          {% endif %}
          <div class="article-content traven-preview">
            {{ post.content_html | raw }}
          </div>
        </article>
      {% endfor %}

      {{ theme.partial('faqs') | raw }}

      <section class="ink-discussion">
        {{ theme.partial('comment-thread') | raw }}
        {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
      </section>
    </div>

  </div>

  {{ theme.partial('sidebar-secondary') | raw }}
</main>

{{ theme.partial('footer') | raw }}
