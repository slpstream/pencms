{
  "type": "native",
  "name": "Bistro",
  "version": "1.0.0",
  "author": "PenCMS",
  "license": "MIT",
  "description": "A restaurant and café theme built around one object: the menu. Condensed signage caps over a warm text serif, bottle green and a glass of wine for color, and a printed-card carte with dot leaders and tabular prices — turning chalkboard-dark after hours.",
  "editor_skin": "bistro",
  "color_mode": "light",
  "supports": {
    "toc": true,
    "hero_image": true,
    "composite": true,
    "seo_meta": true,
    "custom_fonts": false,
    "sidebars": false,
    "markdown_alternate": true
  },
  "variables": {
    "hero_title": {
      "type": "string",
      "required": true
    },
    "posts": {
      "type": "array",
      "required": false
    },
    "dossiers": {
      "type": "array",
      "required": false
    },
    "hero_image": {
      "type": "string",
      "required": false
    },
    "deck": {
      "type": "html",
      "required": false
    },
    "trumpet": {
      "type": "string",
      "required": false
    },
    "date": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "string",
      "required": false
    },
    "dateline": {
      "type": "string",
      "required": false
    },
    "page_title": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "og_title": {
      "type": "string",
      "required": false
    },
    "og_description": {
      "type": "string",
      "required": false
    },
    "og_image": {
      "type": "string",
      "required": false
    },
    "meta_description": {
      "type": "string",
      "required": false
    }
  },
  "style": {
    "groups": [
      {
        "id": "colors",
        "label": "Color Palette",
        "fields": [
          {
            "id": "bg",
            "label": "Background",
            "type": "color",
            "var": "--traven-bg",
            "default": "#f6f2ea"
          },
          {
            "id": "paper",
            "label": "Card / Paper",
            "type": "color",
            "var": "--traven-paper",
            "default": "#fcfaf5"
          },
          {
            "id": "text",
            "label": "Body Text",
            "type": "color",
            "var": "--traven-fg",
            "default": "#23201b"
          },
          {
            "id": "muted",
            "label": "Muted Text",
            "type": "color",
            "var": "--traven-muted",
            "default": "#63594c"
          },
          {
            "id": "accent",
            "label": "Accent / Links",
            "type": "color",
            "var": "--traven-accent",
            "default": "#1e4d39"
          },
          {
            "id": "border",
            "label": "Borders",
            "type": "color",
            "var": "--traven-border",
            "default": "#e2dbcc"
          },
          {
            "id": "code-bg",
            "label": "Code Background",
            "type": "color",
            "var": "--traven-code-bg",
            "default": "#efe9dd"
          }
        ]
      },
      {
        "id": "typography",
        "label": "Typography",
        "fields": [
          {
            "id": "font-display",
            "label": "Display Font",
            "type": "select",
            "var": "--traven-font-display",
            "default": "'Roboto Condensed', sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Roboto Condensed', sans-serif",
                "label": "Roboto Condensed"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              },
              {
                "value": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
                "label": "System Mono"
              }
            ]
          },
          {
            "id": "font-body",
            "label": "Body Font",
            "type": "select",
            "var": "--traven-font-body",
            "default": "'Roboto Condensed', sans-serif",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Roboto Condensed', sans-serif",
                "label": "Roboto Condensed"
              },
              {
                "value": "'Roboto', sans-serif",
                "label": "Roboto"
              },
              {
                "value": "'Inter', sans-serif",
                "label": "Inter"
              },
              {
                "value": "'Outfit', sans-serif",
                "label": "Outfit"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "'Playfair Display', serif",
                "label": "Playfair Display"
              },
              {
                "value": "'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "label": "Atkinson Hyperlegible Next"
              },
              {
                "value": "Georgia, 'Times New Roman', serif",
                "label": "Georgia"
              }
            ]
          },
          {
            "id": "font-mono",
            "label": "Mono Font",
            "type": "select",
            "var": "--traven-font-mono",
            "default": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
            "options": [
              {
                "value": "",
                "label": "Theme default"
              },
              {
                "value": "'Fira Code', monospace",
                "label": "Fira Code"
              },
              {
                "value": "'Courier Prime', 'Courier New', Courier, ui-monospace, monospace",
                "label": "Courier Prime"
              },
              {
                "value": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
                "label": "System Mono"
              }
            ]
          }
        ]
      }
    ]
  },
  "social_preview": {
    "og_accent_color": "#1E4D39",
    "og_vignette_color": "#63594C",
    "og_text_color": "#FCFAF5",
    "og_bar_color": "#1E4D39",
    "og_font": "RobotoCondensed-Bold",
    "og_fonts": {
      "RobotoCondensed-Bold": "assets/fonts/RobotoCondensed-Bold.ttf",
      "RobotoCondensed-Regular": "assets/fonts/RobotoCondensed-Regular.ttf"
    },
    "og_headline_style": "plain",
    "og_text_case": "title",
    "og_grade_preset": "clean",
    "og_accent_bar": true,
    "og_watermark": "assets/images/watermark.png",
    "og_default_hero": "assets/images/defaulthero.jpg",
    "og_default_image": null,
    "og_fallback_title": "Untitled",
    "og_title_fallback": null,
    "og_description_fallback": null,
    "twitter_card": "summary_large_image"
  }
}
