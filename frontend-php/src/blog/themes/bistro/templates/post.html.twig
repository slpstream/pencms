{{ theme.partial('head') | raw }}
{{ theme.partial('header') | raw }}

<main id="main">
    <article class="post dish-page">
        <header class="bistro-post-header page-header">
            {% if trumpet is defined and trumpet is not empty %}
                <p class="dish-course">{{ trumpet }}</p>
            {% endif %}
            <h1>{{ hero_title | default('Untitled') }}</h1>
            {% if date is defined and date is not empty %}
                <p class="meta"><time datetime="{{ date }}">{{ date | date("F d, Y") }}</time>{% if author is defined and author is not empty %} · By {{ author }}{% endif %}</p>
            {% endif %}
        </header>

        {% if hero_image is defined and hero_image is not empty %}
            <img class="cover" src="{{ contentAsset(hero_image) }}" alt="" loading="lazy" decoding="async">
        {% endif %}

        {% if posts is defined and posts is not empty %}
            {% for post in posts %}
                <div class="article-content traven-preview">{{ post.content_html | raw }}</div>
            {% endfor %}
        {% elseif post is defined and post.content_html is defined %}
            <div class="article-content traven-preview">{{ post.content_html | raw }}</div>
        {% endif %}

        {{ theme.partial('faqs') | raw }}

        <section class="bistro-discussion">
            {{ theme.partial('comment-thread') | raw }}
            {{ theme.partial('feedback-form', { kind: 'comment', parent_slug: slug is defined ? slug : '' }) | raw }}
        </section>
    </article>

    {{ theme.partial('sidebar-secondary') | raw }}
</main>

{{ theme.partial('footer') | raw }}
