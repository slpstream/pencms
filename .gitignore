profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the values might
#   not be shared among all users.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if the platform is not identical, the lock file will
#   prevent install on different platforms.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains specific versions, but it can be version controlled.
#poetry.lock

# pdm
.pdm-plugins/
.pdm-python/

# venv
.venv/
venv/
ENV/
env/

# PHP dependencies
/vendor/
composer.lock

