# Copy to pencms.env on the host (mode 0600). Do not commit pencms.env.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=https://192.168.5.199
MCP_RESOURCE_URL=https://192.168.5.199/api/mcp
CORS_ALLOW_ORIGINS=https://192.168.5.199
AGENT_TOKEN_EXPIRE_MINUTES=15
PENCMS_PREVIEW_BASE_URL=http://127.0.0.1:8009
# Pro overlay (optional). Uncomment both after a sibling pencms-pro checkout
# exists. PYTHONPATH is the parent of the pencms_pro package. PHP must see
# PENCMS_PRO_ADMIN or Users/Sites pages 404 even when /api/config says pro.
# PYTHONPATH=/home/user/pencms-pro
# PENCMS_PRO_ADMIN=/home/user/pencms-pro/frontend-php/src/admin
