# Public hostname clients use (no scheme). Caddy site address + TLS.
PUBLIC_HOST=cms.example.com

# HS256 signing secret — required in production; use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Must match the HTTPS origin clients type (scheme + host, no trailing slash).
JWT_ISSUER=https://cms.example.com
MCP_RESOURCE_URL=https://cms.example.com/api/mcp

# Admin UI origin(s), comma-separated. Include https://PUBLIC_HOST when admin
# is served on the same host; add http://127.0.0.1:8009 for local php -S.
CORS_ALLOW_ORIGINS=https://cms.example.com

# Optional access-token TTL (minutes)
AGENT_TOKEN_EXPIRE_MINUTES=15

# Agent MCP loop-guard (default on). In-process sliding window per agent key
# on /api/mcp and /api/v1/mcp/*. Human admin sessions are not counted.
# Set PENCMS_RATE_LIMIT_MCP=0 to disable. Caddy still owns connection floods.
# PENCMS_RATE_LIMIT_MCP_PER_MIN=120

# Customize inspect (Playwright in the API process — not a sidecar).
# Default image is slim (no Chromium). For inspect:
#   PENCMS_API_TARGET=inspect
#   PENCMS_PREVIEW_BASE_URL=http://host.docker.internal:8009
#     (PHP origin as reachable FROM the API container; never the API port.)
# PENCMS_API_TARGET=api
# PENCMS_PREVIEW_BASE_URL=
